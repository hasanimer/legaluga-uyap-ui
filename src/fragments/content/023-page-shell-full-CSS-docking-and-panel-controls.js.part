        const fixedModal = 'body>.dx-overlay-wrapper.dx-overlay-shader[style*="position: fixed"]';
        const boundStatic = 'body>.dx-overlay-wrapper.dx-overlay-shader:not([style*="position: fixed"])>.dx-overlay-content:not(.dx-popup-inherit-height):not(.dx-popup-flex-height)';
        const aw = availableWidth / (zoom / ratio);
        rules.push(`body>.dx-overlay-wrapper:not(.dx-overlay-shader),${fixedModal}{zoom:${1 / ratio}!important}`,
          `${fixedModal},body>.dx-overlay-wrapper:has(>.dx-overlay-content[data-legaluga-dock-modal]){width:${aw}px!important;max-width:${aw}px!important}`,
          `html:not(:has(${fixedModal})) body>.dx-dropdowneditor-overlay>.dx-overlay-content{zoom:${ratio}!important}`,
          `${boundStatic}{display:flex!important;flex-direction:column!important}`,
          `${boundStatic}>.dx-toolbar{flex:none!important}`,
          `${boundStatic}>.dx-popup-content{flex:1 1 auto!important;height:auto!important;min-height:0!important;max-height:none!important}`);
      }
      const lock = (node, horizontal, bottom) => {
        if (!dockFixed.has(node)) dockFixed.set(node, { original: node.getAttribute(DOCK_FIXED_ATTR), id: String(++dockFixedIds) });
        const { id } = dockFixed.get(node);
        if (node.getAttribute(DOCK_FIXED_ATTR) !== id) node.setAttribute(DOCK_FIXED_ATTR, id);
        rules.push(`[${DOCK_FIXED_ATTR}="${id}"]{${horizontal}${bottom}}`);
      };
      const hLock = css => `left:${css.left}!important;right:auto!important;width:${css.width}!important;max-width:${availableWidth / zoom}px!important;`;
      // Zoom tek başına viewport'a bağlı right:0 başlığı sağda bırakır: sağa yaslı fixed öğelerin özgün yatay
      // ölçüleri sabitlenir. Sol yarıdaki öğeler (UYAP'ın sol menüsü) serbest kalır; kilitlenirse menü açılıp
      // kapanınca eski genişliğinde donar. Alt yerleşimde oran 1 olduğu için yatay kilide gerek yoktur.
      const free = [];
