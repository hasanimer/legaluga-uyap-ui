  // UYAP'a en az yarım pencere kalır; panel 320 px'ten dar olmaz.
  const DOCK_MIN = 320;
  const dockMax = width => Math.max(DOCK_MIN, Math.min(720, Math.round(width * .5)));
  const dockWidthFor = (width, pref) => Math.min(dockMax(width), Math.max(DOCK_MIN, Math.round(Number(pref) || Math.min(480, width * .30))));
  let pageZoom = 1, pageZoomRevision = 0;
  function setPanelGeometry(width, height, top = 0) {
