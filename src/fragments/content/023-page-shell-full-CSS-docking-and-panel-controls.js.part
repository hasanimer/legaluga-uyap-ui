    style.setProperty('--panel-scale', String(1 / pageZoom));
    style.setProperty('--panel-width', width + 'px');
    style.setProperty('--panel-height', height + 'px');
    style.setProperty('--dock-width', width / pageZoom + 'px');
    style.setProperty('--dock-height', height / pageZoom + 'px');
    style.setProperty('--drawer-top', top * pageZoom + 'px');
