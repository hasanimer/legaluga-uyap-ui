          if (content === dockModalMoving) dockModalFree.add(content);
          if (dockModalFree.has(content) || (!vw && inline && inline[0] >= 0 && inline[0] + content.offsetWidth <= aw)) continue;
        }
        let id = content.getAttribute(DOCK_MODAL_ATTR);
        if (!id) content.setAttribute(DOCK_MODAL_ATTR, id = String(++dockModalIds));
        const own = dockLength(content.style.maxWidth, aw);
        const maxWidth = Math.min(own === null ? Infinity : own, aw - 2 * margin);
        const size = `[${DOCK_MODAL_ATTR}="${id}"]{${vw ? `width:${Math.min(dockLength(content.style.width, aw), maxWidth)}px!important;` : ''}` +
          `max-width:${maxWidth}px!important}`;
