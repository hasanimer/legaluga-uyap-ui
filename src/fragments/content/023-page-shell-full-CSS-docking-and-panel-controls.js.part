  }

  // Ters zoom'lu katmanda DevExtreme modal pencereyi tüm görünüm alanına göre ortalar; pencere panelin altına taşar.
  // Satır içi vw genişliği sol alana çevrilir, pencerenin en büyük genişliği (DevExtreme maxWidth) korunarak sol alandan
  // geniş pencere daraltılır ve pencere sol alanda ortalanır (UYAP'ın 148 pencere kullanımının 145'i ortalanmış). Konum,
  // boyut kuralı uygulandıktan sonra ölçülür. Kaydırma !important transform iledir: DevExtreme konumu yeniden hesaplasa da
  // bizimki geçerli kalır. Sol alana zaten sığan ya da kullanıcının taşıdığı sürüklenebilir pencereye dokunulmaz. Tam ekran
  // pencere daraltılmış sarmalayıcıyı doldurur.
  // DevExtreme sürüklerken (başlıktan fareyle ya da içerik odaktayken ok tuşuyla) kendi satır içi konumunu değişim kadar
  // kaydırır; o sırada bizim konumumuz da aynı kadar kaydırılır, pencere imleçle birlikte gider. Sürükleme dışındaki satır
  // içi değişiklik DevExtreme'in yeniden konumlamasıdır: pencere ortada (ya da kullanıcının bıraktığı yerde) kalır.
  // Kapanış canlandırmasında (gölge sınıfı kalkmış, pencere görünür) son kural korunur; görünmez olan pencere unutulur ve
  // yeniden açılınca DevExtreme'deki gibi ortadan başlar.
  const DOCK_MODAL_ATTR = 'data-legaluga-dock-modal';
  const DOCK_MODAL_CONTENT = 'body>.dx-overlay-wrapper.dx-overlay-shader[style*="position: fixed"]>.dx-overlay-content';
  const DOCK_MOVE_EVENTS = ['pointerdown', 'pointerup', 'pointercancel', 'keydown', 'keyup'];
  const dockModalPos = new WeakMap(), dockModalFree = new WeakSet(), dockModalSeen = new Set(), dockModalRule = new Map();
  let dockModalSizeStyle, dockModalStyle, dockModalIds = 0, dockModalMoving = null;
  const inlineTranslate = content => {
    const m = /translate\(\s*(-?[\d.]+)px,\s*(-?[\d.]+)px/.exec(content.style.transform || '');
    return m && [Number(m[1]), Number(m[2])];
  };
  // Satır içi uzunluk sol alanın yerel px'ine çevrilir: vw ve % sol alana (daraltılmış sarmalayıcıya) göredir.
  const dockLength = (value, aw) => {
    const m = /^(\d+(?:\.\d+)?)(px|vw|%)$/.exec(value || '');
    return m ? (m[2] === 'px' ? Number(m[1]) : Number(m[1]) / 100 * aw) : null;
  };
