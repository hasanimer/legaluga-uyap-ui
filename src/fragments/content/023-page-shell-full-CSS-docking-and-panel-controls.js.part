    dockModalStyle = writeDockModalStyle(dockModalStyle, places);
  }
  // Kaydırma sürerken DevExtreme konumu ona göre hesapladı (satır içi değer yanlış kalır ve boyut değişmediği için yeniden
  // hesaplanmaz); panel kalkınca açık pencereye DevExtreme'in kendi ortalaması yazılır. Kullanıcının taşıdığı pencerede
  // DevExtreme'in satır içi değeri bırakılır: sonraki sürükleme onun kendi kaydıyla tutarlı başlar.
  function releaseDockedModals() {
