    chrome.runtime.sendMessage({ type: 'uhd-page-zoom' }).then(result => {
      if (revision === pageZoomRevision) applyPageZoom(result?.zoom);
    }).catch(() => {});
  }

  // Dosya açılırken UYAP ekranı sürekli değişir; yerleşim açma bitince bir kez yeniden ölçülür.
  function schedulePanelFit() {
    if (!panel || panel.hidden || dockFrame || opening || panelMode !== 'dock' || gripDrag !== null) return;
    dockFrame = requestAnimationFrame(fitPageBesidePanel);
  }

  function resizePanelDock() {
