          pos = { x: pos.x + inline[0] - pos.inline[0], y: pos.y + inline[1] - pos.inline[1], moved: true };
        } else if (!pos || !pos.moved) {
          pos = { x: full ? 0 : Math.max(margin, (aw - content.offsetWidth) / 2), y: full ? 0 : Math.max(0, (vh - content.offsetHeight) / 2), moved: false };
        }
