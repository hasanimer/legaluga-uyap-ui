  // kapanır. Sabit olmayan panel UYAP'ı küçültmeyen bir çekmecedir: UYAP'ın üst çubuğunun altından başlar, dışarı
  // tıklanınca ya da dosya açılınca kapanır. Kısa bir arama için UYAP iki kez yeniden dizilmez.
  let panelMode = null;   // 'dock' | 'drawer' | null (panel kapalı)
  const drawerWidth = () => Math.min(window.innerWidth * pageZoom, Math.max(DOCK_MIN, Math.min(480, Math.round(window.innerWidth * pageZoom * .30))));
  // UYAP'ın üst çubuğu: sayfanın en üstünde duran, genişliğin çoğunu kaplayan sabit (ya da yapışkan) öğe.
  function uyapTopBar() {
    const w = window.innerWidth;
    for (const node of document.elementsFromPoint(Math.round(w * .6), 1)) {
      if (node === shadowRoot.host || node === document.documentElement || node === document.body) continue;
      if (node.closest('.dx-overlay-wrapper,.swal2-container')) continue;   // açık pencerenin örtüsü
      for (let n = node; n && n !== document.body && n !== document.documentElement; n = n.parentElement) {
        const pos = getComputedStyle(n).position;
        if (pos !== 'fixed' && pos !== 'sticky') continue;
        const r = n.getBoundingClientRect();
        if (r.top <= 1 && r.width >= w * .8 && r.height > 0 && r.height <= 160) return Math.round(r.bottom);
        break;   // çubuk değil: yığındaki bir sonraki öğeye bak
      }
    }
    return 0;
  }
  function fitDrawer() {
    if (panelMode !== 'drawer' || !panel || panel.hidden) return;
    const top = uyapTopBar();
    setPanelGeometry(drawerWidth(), (window.innerHeight - top) * pageZoom, top);
  }
  function clearPanelGeometry() {
    for (const name of ['--panel-scale', '--panel-width', '--panel-height', '--drawer-top']) shadowRoot.host.style.removeProperty(name);
  }
  function stopDrawer() {
    window.removeEventListener('resize', fitDrawer);
    if (!shadowRoot) return;
    delete shadowRoot.host.dataset.dock;
    shadowRoot.host.style.removeProperty('--dock-width');
    shadowRoot.host.style.removeProperty('--drawer-top');
    clearPanelGeometry();
  }
  function applyPanelMode() {
    if (!panel || panel.hidden) return;
    const want = panelPinned() ? 'dock' : 'drawer';
    if (want === panelMode) return;
    if (panelMode === 'dock') stopPanelDock();
    else if (panelMode === 'drawer') stopDrawer();
    panelMode = want;
    if (want === 'dock') startPanelDock();
    else {
      shadowRoot.host.dataset.dock = 'drawer';
      fitDrawer();
      window.addEventListener('resize', fitDrawer);
    }
    syncOverlays();
  }
  function leavePanelMode() {
    if (panelMode === 'dock') stopPanelDock();
    else if (panelMode === 'drawer') stopDrawer();
    panelMode = null;
  }
  // Sekmeden panel yeniden açılabilir; görüntüleyici kendi evrakını ve okuma konumunu korur. Panel açıkken
  // görüntüleyici kalan alanı kullanır ve Tab iki pencere arasında geçer.
  function syncOverlays() {
    if (!overlayOpen()) return;
    const beside = !!panel && !panel.hidden;
    for (const o of [dosyaEkrani]) {
      if (!o) continue;
      o.box.setAttribute('aria-modal', String(!beside));
      if (!beside && !o.box.contains(shadowRoot.activeElement)) o.focus();
    }
  }

  function mountViewerExpand(box, close) {
    const expand = el('button', { type: 'button', class: 'viewer-expand', 'aria-pressed': 'false', title: 'Görüntüleyiciyi kullanılabilir alana genişlet' }, 'Tam ekran');
    close.parentElement.insertBefore(expand, close);
    expand.addEventListener('click', () => {
      const full = box.classList.toggle('expanded');
      expand.setAttribute('aria-pressed', String(full));
      expand.textContent = full ? 'Küçült' : 'Tam ekran';
      expand.title = full ? 'Görüntüleyiciyi pencere boyutuna döndür' : 'Görüntüleyiciyi kullanılabilir alana genişlet';
    });
    return expand;
  }

  // Sabit panelin sol kenarı sürüklenerek (ya da odaktayken ← → ile) genişletilir. Sürüklerken yalnız panel genişler;
  // UYAP bırakınca bir kez yeniden dizilir (tam ölçüm her harekette yapılamayacak kadar pahalı).
  let grip = null, gripDrag = null, gripKeyTimer = null;
  function mountGrip() {
    grip = el('div', { class: 'grip', role: 'separator', tabindex: '0', 'aria-orientation': 'vertical', 'aria-controls': 'legaluga-search-panel',
      'aria-label': 'Panel genişliği', 'aria-valuemin': String(DOCK_MIN), title: 'Sürükleyerek ya da ← → ile panel genişliğini değiştirin' });
    panel.append(grip);
    let start = 0;
    const current = () => Number.parseFloat(shadowRoot.host.style.getPropertyValue('--panel-width')) || drawerWidth();
    const setWidth = w => {
      setPanelGeometry(w, window.innerHeight * pageZoom);
      grip.setAttribute('aria-valuenow', String(w));
    };
    grip.addEventListener('pointerdown', e => {
      if (panelMode !== 'dock' || shadowRoot.host.dataset.dock !== 'side' || e.button !== 0) return;
      e.preventDefault();
      grip.setPointerCapture(e.pointerId);
      grip.classList.add('drag');
      gripDrag = start = current();
    });
    grip.addEventListener('pointermove', e => {
      if (gripDrag === null) return;
      gripDrag = dockWidthFor(window.innerWidth * pageZoom, (panel.getBoundingClientRect().right - e.clientX) * pageZoom);
      setWidth(gripDrag);
    });
    const end = () => {
      if (gripDrag === null) return;
      const w = gripDrag;
      gripDrag = null;
      grip.classList.remove('drag');
      if (w !== start) saveDockWidth(w);
    };
    grip.addEventListener('pointerup', end);
    grip.addEventListener('pointercancel', end);
    grip.addEventListener('keydown', e => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      e.stopPropagation();
      if (panelMode !== 'dock' || shadowRoot.host.dataset.dock !== 'side') return;
      const w = dockWidthFor(window.innerWidth * pageZoom, current() + (e.key === 'ArrowLeft' ? 24 : -24));
      setWidth(w);
      clearTimeout(gripKeyTimer);
      gripKeyTimer = setTimeout(() => saveDockWidth(w), 250);
    });
  }
  async function saveDockWidth(w) {
    clearTimeout(gripKeyTimer);
    pagePrefs = { ...pagePrefs, panelGenislik: w };
    if (panelMode === 'dock') fitPageBesidePanel();
    try {
      if (globalThis.UHDStorage) { await UHDStorage.patchPrefs({ panelGenislik: w }); return; }
      const { uhdPrefs } = await chrome.storage.local.get('uhdPrefs');
      await chrome.storage.local.set({ uhdPrefs: { ...(uhdPrefs || {}), panelGenislik: w } });
    } catch (error) {
      if (invalidated(error)) stopInvalidatedContext();
    }
  }

  function applyPagePrefs(prefs) {
    const oncekiGenislik = pagePrefs.panelGenislik;
    const oncekiCakismaAcik = pagePrefs.cakismaTarama === true;
    pagePrefs = { ...(prefs || {}), panelSabit: prefs?.panelSabit === undefined ? true : prefs.panelSabit };
    if (typeof sessionRequestHooks !== 'undefined') sessionRequestHooks?.preferencesChanged();
    if (typeof dosyaEkrani !== 'undefined') dosyaEkrani?.atifAyariniUygula?.();
    if (pagePrefs.durusmaBildirim === false || (oncekiCakismaAcik && (pagePrefs.cakismaTarama !== true || pagePrefs.cakismaBildirim === false))) closeToast('durusma');
    const theme = pagePrefs.tema || 'auto';
    if (shadowRoot) {
      shadowRoot.host.dataset.theme = theme === 'auto' ? (pageDarkMq && pageDarkMq.matches ? 'dark' : 'light') : theme;
      if (welcomeHost) welcomeHost.dataset.theme = shadowRoot.host.dataset.theme;
    }
    if (pinButton) {
      const pinned = !!pagePrefs.panelSabit;
      const label = pinned ? 'Panel sabit: UYAP’ın yanında durur, yalnız siz kapatınca kapanır. Sabitlemeyi kaldır'
        : 'Paneli sabitle: UYAP’ı daraltıp yanında açık kalsın';
      pinButton.setAttribute('aria-pressed', String(pinned));
      pinButton.setAttribute('aria-label', label);
      pinButton.title = label;
    }
    applyPanelMode();
    if (panelMode === 'dock' && pagePrefs.panelGenislik !== oncekiGenislik) schedulePanelFit();
  }

  function mountPage() {
    const host = document.createElement('div');
    host.id = 'uhd-host';
    host.style.cssText = 'all:initial;position:fixed;top:0;left:0;width:0;height:0;z-index:2147483646';
    document.documentElement.append(host);
    const shadow = host.attachShadow({ mode: 'closed' }); // UYAP sayfasındaki betikler panel içeriğini okuyamaz
    // UYAP'ın Dosya Sorgulama formu Enter'ı pencere düzeyinde (yakalama aşamasında) dinler: detaylı formda sorgu başlatır,
    // basit formda uyarı çıkarır. Panelde basılan Enter (dosya açma, not kaydetme) UYAP'a ulaşmasın. Aynı hedef ve
    // aşamadaki dinleyiciler kayıt sırasıyla çalıştığı için bu, UYAP'ın form her kurulduğunda eklediği dinleyiciden önce gelir.
    window.addEventListener('keyup', e => {
      if (e.key !== 'Enter') return;
      const path = e.composedPath();
      if (path.includes(host) || (welcomeHost && path.includes(welcomeHost))) e.stopImmediatePropagation();
    }, true);
    launch = el('button', { lang: 'tr', class: 'launch', type: 'button', title: BRAND.name + ' · Dosyalarınızda ara', 'aria-label': BRAND.name + ' panelini aç', 'aria-expanded': 'false', 'aria-controls': 'legaluga-search-panel' }, 'Legaluga Asistan');
    const introDone = el('button', { type: 'button' }, 'Anladım');
    const introText = el('p', null, 'UYAP dosyalarınızda aramak için sağ kenardaki sekmeye tıklayın.');
    introTip = el('div', { lang: 'tr', class: 'launch-tip', role: 'status', hidden: true },
      el('strong', null, 'Legaluga Asistan burada'), introText, introDone);
    chrome.runtime.sendMessage({ type: 'uhd-shortcut' }).then(r => {
      if (r && r.shortcut) introText.textContent = `UYAP dosyalarınızda aramak için sağ kenardaki sekmeye tıklayın ya da ${r.shortcut} tuşlarına basın.`;
    }).catch(() => {});
    introDone.addEventListener('click', dismissLauncherIntro);
    panel = el('div', { lang: 'tr', class: 'panel', id: 'legaluga-search-panel', role: 'dialog', 'aria-label': BRAND.name, 'aria-modal': 'false', hidden: true });
    announcementEl = el('div', { class: 'announcement', role: 'status', 'aria-live': 'polite', hidden: true });
    notificationArea = el('div', { lang: 'tr', class: 'notifications' }, announcementEl);
    liveRegion = el('div', { lang: 'tr', class: 'sr', role: 'status', 'aria-live': 'polite', 'aria-atomic': 'true' });
    alertRegion = el('div', { lang: 'tr', class: 'sr', role: 'alert', 'aria-live': 'assertive', 'aria-atomic': 'true' });
    shadow.append(el('style', null, PAGE_CSS), launch, introTip, panel, notificationArea, liveRegion, alertRegion);
    shadowRoot = shadow;
    chrome.runtime.onMessage.addListener((message, sender) => {
      if (sender.id !== chrome.runtime.id || message?.type !== 'uhd-page-zoom') return;
      pageZoomRevision++;
      applyPageZoom(message.zoom);
    });
    readPageZoom();
    window.addEventListener('resize', readPageZoom, { passive: true });
    ui = mountUI(panel, {
      mode: 'page',
      downloads: downloadManager,
      openDownload,
      showDownloadPart,
      isVisible: () => !!panel && !panel.hidden,
      onOpen: r => openFile(r),
      onOpenEvrak: (r, k, group, baglam) => openEvrak(r, k, group, baglam),
      onDosyaPanel: (r, tab, baglam) => openDosyaPanel(r, tab, baglam),
      onSiraylaOku: kuyruk => siraylaOku(kuyruk, 0),
      onSetupConnection: options => setupConnection(options),
      onSetupOpenUyap: () => chrome.runtime.sendMessage({ type: 'uhd-setup-open' }),
      onSetupScan: () => chrome.runtime.sendMessage({ type: 'uhd-setup-scan' }),
      onUpdate: async full => {
        const res = await startUpdate(full);
        if (!res.ok) ui.setNotice(res.error, 'err');
      },
      onCbsDirectory: ilKodu => startCbsDirectory(ilKodu),
      onCbsScan: scope => startCbsScan(scope),
      onStop: () => stopUpdate(),
      onClose: () => closePanel(true),
      onEscape: closeTop,
      onInvalidated: stopInvalidatedContext
    });
    pinButton = el('button', { class: 'panel-pin', type: 'button', 'aria-pressed': 'false', disabled: true });
    const pinIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    pinIcon.setAttribute('viewBox', '0 0 24 24');
    pinIcon.setAttribute('aria-hidden', 'true');
    const pinPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    pinPath.setAttribute('d', 'M16 3 21 8 17 9 13 13 12 17 7 12 11 11 15 7Z M7 17 3 21');
    pinIcon.append(pinPath);
    pinButton.append(pinIcon);
    const header = ui.root.querySelector('header');
    if (header) header.insertBefore(pinButton, header.querySelector('.x'));
    mountGrip();
    pinButton.addEventListener('click', async () => {
      pinSaving = true;
      syncPinAvailability();
      try {
        if (globalThis.UHDStorage) { applyPagePrefs(await UHDStorage.togglePref('panelSabit')); return; }
        const { uhdPrefs } = await chrome.storage.local.get('uhdPrefs');
        // Depodaki son değeri değiştir; başka bir pencerenin güncellediği tercihi tersine çevirme.
        const next = { ...(uhdPrefs || {}), panelSabit: uhdPrefs?.panelSabit === false };
        await chrome.storage.local.set({ uhdPrefs: next });
        applyPagePrefs(next);
      } catch (error) {
        if (invalidated(error)) stopInvalidatedContext();
        else toast('Panel tercihi kaydedilemedi. Tekrar deneyin.', 'err', 5000, null, { id: 'panel' });
      } finally { pinSaving = false; syncPinAvailability(); }
    });
    applyPagePrefs(pagePrefs);
    chrome.storage.onChanged.addListener((changes, area) => {
      if (area === 'local' && changes.uhdPrefs) {
        prefsRevision++;
        prefsLoaded = true;
        applyPagePrefs(changes.uhdPrefs.newValue);
        syncPinAvailability();
      }
      if (area === 'local' && changes.uhdLauncherIntroPending) applyLauncherIntro(changes.uhdLauncherIntroPending.newValue);
    });
    const initialPrefsRevision = prefsRevision;
    prefsReady = chrome.storage.local.get('uhdPrefs').then(v => {
      // İlk okuma, bu arada gelen storage.onChanged olayını geri almamalı. panelPinned() prefsLoaded'a baktığı için
      // bayrak önce kalkar; tercih gelmeden açılmış panel sabitse yuvaya geçer.
      prefsLoaded = true;
      if (prefsRevision === initialPrefsRevision) applyPagePrefs(v.uhdPrefs);
      else applyPanelMode();
      syncPinAvailability();
      if (!pagePrefs.panelSabit) ssSet(SS_PANEL, null);
      else restorePinnedPanel();
    }).catch(error => {
      if (invalidated(error)) stopInvalidatedContext();
      else { prefsLoaded = true; syncPinAvailability(); }
    });
    chrome.storage.local.get('uhdLauncherIntroPending').then(v => applyLauncherIntro(v.uhdLauncherIntroPending)).catch(error => {
      if (invalidated(error)) stopInvalidatedContext();
    });
    if (pageDarkMq && pageDarkMq.addEventListener) pageDarkMq.addEventListener('change', () => applyPagePrefs(pagePrefs));
    observeAccessMenu();
    launch.addEventListener('click', () => {
      if (!contextAvailable()) return;
      if (panel.hidden) showPanel();
      else closePanel(true);
    });
    panel.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !e.defaultPrevented) {
        e.preventDefault();
        e.stopPropagation();
        closeTop();
      }
    });
    // UYAP'ın tıklama işlemi bitsin; basılan öğe pointerdown ile click arasında kaymasın.
    // Gölge DOM içindeki tıklamaların hedefi host olarak görünür.
    document.addEventListener('click', e => {
      if (!e.isTrusted) return;
      if (e.target === host || (welcomeHost && e.target === welcomeHost && panelMode === 'dock')) { cancelOutsideClose(); return; }
      if (panel.hidden || !prefsLoaded || pagePrefs.panelSabit) return;
      cancelOutsideClose();
      const epoch = panelEpoch;
      outsideCloseTimer = setTimeout(() => {
        outsideCloseTimer = null;
        if (panelEpoch === epoch && prefsLoaded && !pagePrefs.panelSabit) closePanel();
      }, 0);
    }, true);
    announcementEl.addEventListener('load', updateAnnouncementScroll, true);
    // Esc, süren dosya açmayı durdurur: yalnız Durdur sunulurken (UYAP'a pencere tıklaması gitmeden) ve odak sayfanın
    // gövdesinde ya da dosya açma bildirimindeyken. UYAP'ın kendi pencereleri de Esc dinler; odak onlardaysa ya da
    // olayı eklentinin kendisi gönderdiyse (açık pencereyi kapatırken) dokunulmaz.
    window.addEventListener('keydown', e => {
      if (e.key !== 'Escape' || !e.isTrusted || e.defaultPrevented || !openRun || openRun.cancelled || !openRun.stoppable) return;
      const a = document.activeElement;
      const acma = toasts.get('acma');
      const inToast = a === host && !!acma && acma.el.contains(shadowRoot.activeElement);
      if (!inToast && a !== document.body && a !== document.documentElement && a !== null) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      openRun.userStop = true;
      openRun.cancelled = true;
      openRun.ctl.abort();
    }, true);
  }

  function restorePinnedPanel() {
    if (panelPinned() && ssGet(SS_PANEL) === '1' && panel?.hidden && !openRun && inSession() && document.querySelector('#root'))
      showPanel({ focus: false });
  }

  function showPanel({ focus = true } = {}) {
    if (!panel || accessMenuOpen || !contextAvailable()) return;
    panelWanted = true;
    ssSet(SS_PANEL, '1');
    if (introTip && !introTip.hidden) dismissLauncherIntro();
    else launcherIntroSeen = true;
    cancelOutsideClose();
    panelEpoch++;
    const wasHidden = panel.hidden, before = document.activeElement;
    panel.hidden = false;
    applyPanelMode();
    if (panel.hidden) return;   // syncOverlays paneli yeniden gizledi
    ui.refreshStatus();
    if (wasHidden) focusBeforePanel = before;
    launch.setAttribute('aria-expanded', 'true');
    launch.setAttribute('aria-label', BRAND.name + ' panelini kapat');
    if (focus) ui.focus();
  }

  // Örtü ya da erişilebilirlik menüsü paneli yalnız geçici gizler; kapanınca kullanıcının istediği panel geri gelir.
  function resumePanel(focus = false) {
    if (panelWanted && panel.hidden && !overlayOpen()) showPanel({ focus });
  }

  // Paneldeki Esc: yanında açık görüntüleyici ya da dosya paneli varsa önce o kapanır, yoksa panel.
  function closeTop() {
    if (dosyaEkrani) dosyaEkrani.close();
    else closePanel(true);
  }

  // Kullanıcının kapatması: panel geçici gizlenmez, açık kalma isteği de silinir.
  function closePanel(restoreFocus = false) {
    panelWanted = false;
    ssSet(SS_PANEL, null);
    hidePanel(restoreFocus);
  }

  function hidePanel(restoreFocus = false) {
    if (!panel || panel.hidden) return;
    cancelOutsideClose();
    panelEpoch++;
    panel.hidden = true;
    leavePanelMode();
    launch.setAttribute('aria-expanded', 'false');
    launch.setAttribute('aria-label', BRAND.name + ' panelini aç');
    syncOverlays();
    if (restoreFocus && !overlayOpen()) {
      const previous = focusBeforePanel;
      const target = previous && previous !== shadowRoot.host && previous !== document.body && previous.isConnected ? previous : launch;
      target.focus({ preventScroll: true });
    }
  }

  // ---------------------------------------------------------------- Evrakı açma
  // Evrak kimlikleri her yanıtta yeniden şifrelendiği için saklanmaz: açarken dosyanın evrak listesi yeniden
  // alınır, evrak anahtarıyla (birim evrak no + onay tarihi + tür) bulunur ve UYAP'ın kendi görüntüleme
  // adresinden getirilip sayfa içinde gösterilir. Evrak içeriği saklanmaz; pencere kapanınca bellekten atılır.

