      dockStyle.textContent = rules.join('\n');
      document.documentElement.append(dockStyle);
      fitDockedModals();
      // Bekçi: yüzde ya da viewport birimli ölçü zoom ile küçülmez ve içeriğin üstüne biner; öyleyse eskisi gibi kilitlenir.
      const count = rules.length;
      for (const [node, before, horizontal] of free) {
        const after = node.getBoundingClientRect();
        if (Math.abs(after.width - before.width * ratio) > 1 || Math.abs(after.left - before.left * ratio) > 1) lock(node, horizontal, '');
      }
      if (rules.length !== count) dockStyle.textContent = rules.join('\n');
    } finally {
      // Yeni kilit geçiş kapalıyken hesaplansın; ölçüm stili kalkınca geçiş yeniden başlamasın.
      for (const node of dockFixed.keys()) if (node.isConnected) getComputedStyle(node).width;
      dockMeasureStyle.remove();
    }
