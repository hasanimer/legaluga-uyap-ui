    if (acPanel) open = acPanel.classList.contains('show');
    else if (heading && heading.isConnected && visible(heading)) {
      // Panel yandayken sayfa zoom ile küçülür ve menü panelin soluna yerleşir.
      const docked = panel && !panel.hidden && shadowRoot.host.dataset.dock === 'side';
      const z = docked ? (Number.parseFloat(getComputedStyle(document.body).zoom) || 1) : 1;
      const edge = docked ? innerWidth - (Number.parseFloat(shadowRoot.host.style.getPropertyValue('--dock-width')) || 0) : innerWidth;
      for (let node = heading; node && node !== document.body && node !== document.documentElement; node = node.parentElement) {
