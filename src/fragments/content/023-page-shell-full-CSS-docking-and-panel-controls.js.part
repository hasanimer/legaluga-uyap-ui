    const zoom = Number(value);
    if (!Number.isFinite(zoom) || zoom < .25 || zoom > 5 || zoom === pageZoom) return;
    pageZoom = zoom;
    if (panelMode === 'dock') schedulePanelFit();
    else if (panelMode === 'drawer') fitDrawer();
  }
