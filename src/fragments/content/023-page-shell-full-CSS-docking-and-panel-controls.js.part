  // DevExtreme pencereyi gösterirken aynı görevde konumlar; eşzamanlı sığdırma 120 ms'lik gecikmedeki sıçramayı önler.
  // Yalnız katmanın kendisi (sarmalayıcı ya da içerik kutusu) izlenir: içteki satırların durum sınıfları (ör. dx-state-hover)
  // sığdırmayı yeniden çalıştırmaz.
  const overlayRecord = r => r.type === 'childList'
    ? [...r.addedNodes].some(n => n.nodeType === 1 && n.classList.contains('dx-overlay-wrapper'))
    : !!(r.target.classList && (r.target.classList.contains('dx-overlay-wrapper') || r.target.classList.contains('dx-overlay-content')));

