  const { el, mountUI, BRAND } = globalThis.UHD;
  const downloadManager = globalThis.UHDBulkDownloadEngine && globalThis.UHDStorage?.readBulkDownload
    ? globalThis.UHDBulkDownloadEngine.createManager({
      bulkTools: globalThis.UHDBulkDownload, zipTools: globalThis.UHD.evrakZip, storage: globalThis.UHDStorage,
      sink: message => chrome.runtime.sendMessage(message),
      reconcile: fileKey => chrome.runtime.sendMessage({ type: 'uhd-download-reconcile', fileKey }),
      locks: globalThis.navigator?.locks, documentExtension,
      continuation: { remember: rememberDownload, forget: forgetDownload },
      beforeFetch: signal => { uyapBulk(signal); if (captchaOpen()) throw new Blocked(CAPTCHA_MSG); }
    }) : null;
  globalThis.UHDBulkDownloads = downloadManager;
  async function openDownload(fileKey) {
    const { uhdIndex } = await chrome.storage.local.get('uhdIndex');
    const rec = uhdIndex?.records?.find(item => item.key === fileKey);
    if (!rec) throw new Error('Dosya kayıtlarınızda bulunamadı. Dosya listenizi güncelleyin.');
    return openDosyaPanel(rec, 'indir');
  }
  async function showDownloadPart({ fileKey, jobId, downloadId }) {
    const result = await chrome.runtime.sendMessage({ type: 'uhd-download-show', fileKey, jobId, downloadId });
    if (!result?.ok) throw new Error(result?.error || 'ZIP dosyası gösterilemedi.');
    return result;
  }
  const PAGE_CSS = `
:host{--shell-focus:${BRAND.focus};--shell-bg:#fff;--shell-soft:#f5f7fb;--shell-text:#1d2939;--shell-muted:#667085;--shell-line:#e3e8f2;--shell-accent:${BRAND.primary};--shell-warn-bg:#fff4e5;--shell-warn-text:#7a4b00;--shell-warn:#d97706;--shell-error:#b42318;--shell-error-bg:#fef3f2;--shell-success:#12805c;--shell-success-bg:#ecfdf3}
:host([data-theme=dark]){--shell-focus:#7fd6cc;--shell-bg:#18222d;--shell-soft:#0f1720;--shell-text:#e6edf3;--shell-muted:#a8b5c3;--shell-line:#3a4756;--shell-accent:#7fd6cc;--shell-warn-bg:#33270f;--shell-warn-text:#f5c26b;--shell-warn:#f5c26b;--shell-error:#f97066;--shell-error-bg:#351a18;--shell-success:#6ce9a6;--shell-success-bg:#0f2a1f;color-scheme:dark}
/* UYAP'ın erişilebilirlik aracı !important stillerle host'a yazı tipi/aralık geçirebilir; panel ve pencereler etkilenmez. */
:host(#uhd-host){font:initial!important;letter-spacing:normal!important;word-spacing:normal!important;text-transform:none!important;text-indent:0!important;text-shadow:none!important}
.launch{position:fixed;right:0;top:clamp(116px,calc(50% - 112px),calc(100dvh - 76px));transform:translateY(-50%);writing-mode:vertical-rl;writing-mode:sideways-lr;background:${BRAND.primary};color:#fff;border:0;
  border-radius:12px 0 0 12px;padding:16px 10px;min-width:40px;min-height:104px;font:600 12px "Segoe UI",system-ui,sans-serif;cursor:pointer;box-shadow:0 4px 16px rgba(16,75,73,.24);z-index:6;transition:background .15s,box-shadow .15s}
.launch:hover{background:${BRAND.primaryDark};box-shadow:0 6px 20px rgba(16,75,73,.32)}
.launch[aria-expanded=true]{visibility:hidden}
.launch-tip{position:fixed;right:52px;top:clamp(116px,calc(50% - 112px),calc(100dvh - 76px));transform:translateY(-50%);z-index:3;width:min(270px,calc(100vw - 68px));box-sizing:border-box;padding:12px 14px;border:1px solid var(--shell-line);border-radius:12px;background:var(--shell-bg);color:var(--shell-text);box-shadow:0 8px 28px #0003;font:12px/1.45 "Segoe UI",system-ui,sans-serif}
.launch-tip::after{content:"";position:absolute;right:-7px;top:calc(50% - 7px);width:12px;height:12px;background:var(--shell-bg);border-top:1px solid var(--shell-line);border-right:1px solid var(--shell-line);transform:rotate(45deg)}
.launch-tip strong{display:block;font-size:13px;color:var(--shell-accent)}
.launch-tip p{margin:5px 0 9px}.launch-tip button{border:0;border-radius:7px;background:${BRAND.primary};color:#fff;padding:6px 10px;font:inherit;font-weight:600;cursor:pointer}
.launch-tip button:focus-visible{outline:3px solid var(--shell-focus);outline-offset:2px}
.panel{position:fixed;top:0;right:0;zoom:var(--panel-scale,1);height:var(--panel-height,100dvh);width:var(--panel-width,min(480px,100vw));box-shadow:-8px 0 36px rgba(0,0,0,.2);z-index:2;overscroll-behavior:contain}
:host([data-dock=drawer]) .panel{top:var(--drawer-top,0px);border-top-left-radius:12px;overflow:hidden;box-shadow:-10px 0 40px rgba(0,0,0,.28)}
.panel .grip{position:absolute;left:-5px;top:0;bottom:0;width:10px;cursor:ew-resize;z-index:1;touch-action:none}
.panel .grip::after{content:"";position:absolute;left:4px;top:50%;width:3px;height:44px;margin-top:-22px;border-radius:2px;background:var(--shell-muted);opacity:0;transition:opacity .15s}
.panel .grip:hover::after,.panel .grip:focus-visible::after,.panel .grip.drag::after{opacity:.7}
.panel .grip:focus-visible{outline:2px solid var(--shell-focus);outline-offset:-2px}
:host(:not([data-dock=side])) .panel .grip{display:none}
.panel .panel-pin{display:inline-flex;align-items:center;justify-content:center;flex:none;width:32px;height:32px;padding:7px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--muted);cursor:pointer}
.panel .panel-pin svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.panel .panel-pin:hover,.panel .panel-pin[aria-pressed=true]{background:var(--soft);border-color:var(--bord);color:var(--accent-text)}
.panel .panel-pin:disabled{opacity:.55;cursor:wait}
.launch:focus-visible,.toast button:focus-visible,.announcement button:focus-visible,.viewer :is(button,a):focus-visible{outline:3px solid var(--shell-focus);outline-offset:3px}
.notifications{position:fixed;right:56px;bottom:16px;width:max-content;max-width:min(440px,calc(100vw - 72px));z-index:5;display:flex;flex-direction:column;align-items:flex-end;gap:8px;pointer-events:none}
.notifications>*{pointer-events:auto;max-width:100%;box-sizing:border-box}
.toast{--k:var(--shell-accent);background:var(--shell-bg);color:var(--shell-text);border:1px solid var(--shell-line);border-left:4px solid var(--k);padding:10px 8px 10px 12px;border-radius:10px;
  width:max-content;max-width:100%;font:13px/1.45 "Segoe UI",system-ui,sans-serif;box-shadow:0 8px 28px rgba(16,24,40,.24);
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 6px;align-items:start}
.toast .msg{grid-column:1;grid-row:1;white-space:pre-line;min-width:0;overflow-wrap:anywhere;padding-top:1px}
.toast .title{display:block;font-weight:600}
.toast .meta{color:var(--shell-muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.toast .sub{display:block;margin-top:2px;color:var(--shell-muted);font-size:12px}
.toast .actions{grid-column:1/-1;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px}
.toast.busy .txt::before{content:"";display:inline-block;width:10px;height:10px;margin-right:7px;border:2px solid var(--shell-line);
  border-top-color:var(--k);border-radius:50%;animation:uhdspin .8s linear infinite;vertical-align:-1px}
@keyframes uhdspin{to{transform:rotate(360deg)}}
.toast button{flex:none;min-height:32px;border:1px solid var(--shell-line);background:var(--shell-bg);color:var(--shell-text);border-radius:7px;padding:4px 10px;font:inherit;font-size:12px;font-weight:600;cursor:pointer}
.toast .actions button:first-child{border-color:var(--k)}
.toast button:hover{background:var(--shell-soft)}
.toast button.close{grid-column:2;grid-row:1;margin:-4px -2px 0 0;border:0;background:none;color:var(--shell-muted);font-size:20px;font-weight:400;line-height:1;min-width:32px;padding:4px}
.toast.success{--k:var(--shell-success)}.toast.warn{--k:var(--shell-warn)}.toast.danger{--k:var(--shell-error);background:var(--shell-error-bg)}
.sr{position:fixed;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.panel:not([hidden]) ~ .notifications{right:calc(var(--dock-width,480px) + 44px);max-width:min(440px,calc(100vw - var(--dock-width,480px) - 60px))}
@media(max-width:800px){:host(:not([data-dock=drawer])) .panel:not([hidden]) ~ .notifications{right:56px;bottom:80px;max-width:calc(100vw - 68px)}.notifications{right:56px;bottom:12px;max-width:calc(100vw - 68px)}}
:host([data-dock=bottom]) .panel{top:auto;bottom:0;box-shadow:0 -8px 36px rgba(0,0,0,.2)}
:host([data-dock=bottom]) .panel:not([hidden]) ~ .notifications{right:56px;bottom:calc(var(--dock-height) + 12px);max-width:calc(100vw - 68px)}
.announcement{width:360px;max-height:60vh;max-height:60dvh;overflow:auto;overscroll-behavior:contain;pointer-events:auto;padding:10px 12px;border:1px solid var(--shell-line);border-left:3px solid var(--shell-accent);border-radius:12px;background:var(--shell-bg);color:var(--shell-text);box-shadow:0 6px 24px #0002;font:12px/1.45 "Segoe UI",system-ui,sans-serif}
.announcement[hidden]{display:none}.announcement.scrollable{pointer-events:auto}
.announcement .head{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.announcement strong{flex:1;color:var(--shell-accent);font-size:12px}
.announcement.outage{width:380px;border-left:4px solid #d97706;background:var(--shell-warn-bg);box-shadow:0 8px 30px rgba(130,68,0,.24)}
.announcement.outage strong{color:var(--shell-warn-text);font-size:13px}
.announcement .subtitle{color:var(--shell-muted);font-size:11px;margin-bottom:6px}
.announcement .close{flex:none;width:26px;height:26px;pointer-events:auto;border:0;border-radius:7px;background:none;color:var(--shell-muted);font-size:19px;cursor:pointer}
.announcement .close:hover{background:var(--shell-soft)}
.announcement .announcement-body :is(p,ul,ol,blockquote,pre,table){margin:4px 0}
.announcement .announcement-body a[href]{pointer-events:auto}
.announcement-body{min-height:0;overflow:visible;white-space:normal;line-height:1.65;overflow-wrap:anywhere}
.announcement-body img{max-width:100%;height:auto}.announcement-body a[href]{color:var(--shell-accent);text-decoration:underline}
.announcement-body :is(h1,h2,h3){line-height:1.35}.announcement-body table{display:block;max-width:100%;overflow:auto;border-collapse:collapse}
.announcement-body :is(td,th){border:1px solid var(--shell-line);padding:6px}
@media(prefers-reduced-motion:reduce){.launch{transition:none}.toast.busy .txt::before{animation:none}}
.viewer{position:fixed;inset:0;background:rgba(16,24,40,.55);z-index:4;display:flex;align-items:center;justify-content:center}
:host(:is([data-dock=side],[data-dock=drawer])) .panel:not([hidden]) ~ .viewer{right:var(--dock-width)}
:host([data-dock=bottom]) .panel:not([hidden]) ~ .viewer{bottom:var(--dock-height)}
.viewer .box{background:var(--shell-bg);width:calc(100% - 32px);height:calc(100% - 32px);border-radius:16px;display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.35);font:13px/1.4 "Segoe UI",system-ui,sans-serif;color:var(--shell-text)}
.viewer .box.expanded{width:100%;height:100%;border-radius:0}
.viewer .bar{display:flex;gap:10px;align-items:center;padding:10px 12px;background:${BRAND.primary};color:#fff;flex-wrap:wrap}
.viewer .bar b{flex:1;font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.viewer .bar a,.viewer .bar button{color:#fff;border:1px solid rgba(255,255,255,.6);background:none;border-radius:6px;padding:8px 10px;font:inherit;cursor:pointer;text-decoration:none}
.viewer .bar :is(a,button):focus-visible{outline-color:#fff}
.viewer iframe{flex:1;border:0;width:100%}
.viewer iframe.htmldoc{background:#fff;color-scheme:light}
.viewer .imgdoc{flex:1;overflow:auto;display:flex;align-items:flex-start;justify-content:center;padding:12px;background:var(--shell-soft)}
.viewer .imgdoc img{max-width:100%;height:auto}
.viewer .msg{padding:28px;color:var(--shell-text)}
.viewer .dp-body{flex:1;overflow:auto;overscroll-behavior:contain;padding:12px 14px;background:var(--shell-bg)}
.viewer .dp-muted{color:var(--shell-muted);font-size:12px;margin:6px 0}
.viewer .dp-err{color:var(--shell-error);margin:6px 0}
.viewer .dp-tablewrap{max-height:320px;overflow:auto}
.viewer .dp-table thead th{position:sticky;top:0;background:var(--shell-bg);z-index:1}
.viewer .dp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.viewer .dp-card{border:1px solid var(--shell-line);border-radius:10px;padding:10px 12px}
.viewer .dp-card h4{margin:0 0 6px;font-size:13px}
.viewer .dp-card div{margin:2px 0}
.viewer .tebligat-panel{display:grid;gap:18px;max-width:1080px;width:100%;margin:0 auto}
.viewer .te-form{padding:18px;min-width:0}
.viewer .te-form h4{font-size:16px;margin:0 0 8px}
.viewer .te-form :is(.te-fields,.te-field,.te-document,.te-actions,.te-status){margin:0}
.viewer .te-fields{display:grid;grid-template-columns:minmax(190px,.8fr) minmax(0,1.2fr);gap:14px;margin-top:18px!important}
.viewer .te-field{display:grid;gap:7px;min-width:0}
.viewer .te-field label{color:var(--shell-muted);font-size:13px}
.viewer .te-field :is(input,select){width:100%;min-height:40px;box-sizing:border-box;border:1px solid var(--shell-line);border-radius:8px;background:var(--shell-bg);color:var(--shell-text);padding:9px 11px;font:inherit}
.viewer .te-field input{font-variant-numeric:tabular-nums;letter-spacing:.04em}
.viewer .te-document-picker{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px 12px;align-items:end;margin-top:16px!important}
.viewer .te-document-picker>.dp-muted{grid-column:1/-1;margin:0;line-height:1.55}
.viewer .te-document-picker>.chip{min-height:40px}
.viewer .te-document-actions{display:flex;flex-wrap:wrap;gap:8px}
.viewer .te-document-actions>.chip{min-height:40px}
.viewer .tebligat-panel :is(button,input,select,a):focus-visible{outline:2px solid var(--shell-focus);outline-offset:3px}
.viewer .te-document{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:12px!important}
.viewer .te-document-label{color:var(--shell-muted);font-size:12px;overflow-wrap:anywhere;flex:1;min-width:150px}
.viewer .te-actions{display:flex;align-items:center;gap:10px;margin-top:18px!important}
.viewer .te-actions button{min-height:38px}
.viewer .te-provider-hint{color:var(--shell-muted);font-size:12px;line-height:1.6;margin:12px 0 0}
.viewer .te-status{font-size:13px;line-height:1.6;overflow-wrap:anywhere}
.viewer .te-status:not(:empty){padding:10px 12px;border-radius:8px;background:var(--shell-soft);margin-top:12px!important}
.viewer .te-status.err{color:var(--shell-error)}
.viewer .te-candidates{display:flex;flex-wrap:wrap;gap:8px;min-width:0;border:1px solid var(--shell-line);border-radius:8px;padding:12px;margin:14px 0 0}
.viewer .te-candidates legend{font-size:12px;color:var(--shell-muted);padding:0 5px}
.viewer .te-results{border:1px solid var(--shell-line);border-radius:12px;padding:18px;min-width:0}
.viewer .te-document-records{background:var(--shell-soft)}
.viewer .te-document-records .te-tablewrap{margin-top:14px}
.viewer .te-result-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.viewer .te-result-head>div{min-width:0;overflow-wrap:anywhere}
.viewer .te-result-head h3{font-size:18px;line-height:1.4;margin:5px 0 8px}
.viewer .te-result-head>a{flex-shrink:0;text-decoration:none}
.viewer .te-source{color:var(--shell-muted);font-size:12px}
.viewer .te-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 22px;margin:18px 0}
.viewer .te-details>div{padding:9px 0;border-bottom:1px solid var(--shell-line);min-width:0}
.viewer .te-details dt{color:var(--shell-muted);font-size:12px;margin-bottom:4px}
.viewer .te-details dd{margin:0;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
.viewer .te-events-title{display:flex;align-items:center;gap:8px;font-size:14px;margin:20px 0 10px}
.viewer .te-tablewrap{overflow:auto;border:1px solid var(--shell-line);border-radius:8px}
.viewer .te-table{border-collapse:collapse;width:100%;font-size:13px;line-height:1.5;text-align:left}
.viewer .te-table th{color:var(--shell-muted);background:var(--shell-soft);font-size:12px;font-weight:500}
.viewer .te-table :is(th,td){padding:10px 12px;vertical-align:top;border-bottom:1px solid var(--shell-line);overflow-wrap:anywhere}
.viewer .te-table tr:last-child td{border-bottom:0}
.viewer .te-date{white-space:nowrap;font-variant-numeric:tabular-nums}
.viewer :is(.te-candidates,.te-results)[hidden]{display:none}
.viewer .dp-k{color:var(--shell-muted)}
.viewer .dp-body:has(>.dp-overview){min-height:0;overflow:hidden}
.viewer .dp-overview{height:100%;min-height:0;display:grid;grid-template-rows:clamp(152px,26%,172px) minmax(0,1fr);gap:12px}
.viewer .dp-overview-main{min-height:0;display:grid;grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);gap:12px}
.viewer .dp-summary{min-height:0;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:6px}
.viewer .dp-summary-grid{min-height:0;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:12px}
.viewer :is(.dp-summary,.dp-finance) .dp-card,.viewer .dp-summary-parties{min-width:0;min-height:0;display:flex;flex-direction:column;padding:12px;border-radius:12px}
.viewer .dp-summary-parties{margin:0}
.viewer :is(.dp-summary,.dp-finance) .dp-card h4,.viewer .dp-summary-parties h4{flex:none;margin:0 0 8px;font-size:14px}
.viewer .dp-summary-scroll{min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable;flex:1;margin:0!important}
.viewer .dp-summary-scroll>:last-child{margin-bottom:0}
.viewer .dp-summary-scroll:focus-visible{outline:2px solid var(--shell-focus);outline-offset:-2px;border-radius:4px}
.viewer .dp-summary-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px;align-content:start}
.viewer .dp-card .dp-summary-row{display:grid;grid-template-columns:minmax(100px,.8fr) minmax(0,1.2fr);gap:8px 16px;margin:0;padding:7px 0;border-bottom:1px solid var(--shell-line);line-height:1.5}
.viewer .dp-summary-grid .dp-summary-row{grid-template-columns:minmax(70px,.65fr) minmax(0,1.35fr);padding:2px 0;border:0;line-height:1.4;gap:6px 10px}
.viewer .dp-summary-row:last-child{border-bottom:0}
.viewer .dp-summary-row :is(.dp-k,.dp-v){min-width:0;overflow-wrap:anywhere}
.viewer .dp-summary-row .dp-v .dp-muted{margin:0}
.viewer .dp-status{display:inline-block;padding:2px 8px;border-radius:6px;background:var(--shell-soft);font-weight:600}
.viewer .dp-status.open{color:var(--shell-success)}
.viewer .dp-status.closed{color:var(--shell-muted)}
.viewer .dp-summary-source{color:var(--shell-muted);font-size:12px;line-height:1.5;margin:0}
.viewer .dp-summary-count{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:20px;background:var(--shell-soft);color:var(--shell-muted);font-size:12px;font-weight:500}
.viewer .dp-summary-parties .dp-tablewrap{max-height:none;border:1px solid var(--shell-line);border-radius:8px}
.viewer .dp-overview-finance{min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);gap:8px}
.viewer .dp-overview-finance>.dp-baslik{margin:0;font-size:14px}
.viewer .dp-finance-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}
.viewer .dp-finance-heading>.dp-baslik{margin:0;font-size:14px}
.viewer .dp-finance-refresh{flex:none;font-size:12px}
.viewer .dp-finance{min-height:0;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:8px;margin:0}
.viewer .dp-finance-grid{min-height:0;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:12px}
.viewer .dp-finance-side{min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);gap:12px}
.viewer .dp-finance .dp-finance-followup{display:block}
.viewer .dp-finance-followup>summary{font-size:14px;font-weight:600;cursor:pointer;line-height:20px}
.viewer .dp-finance-followup>.dp-summary-scroll{max-height:130px;margin-top:8px!important}
.viewer .dp-card .dp-money-row{grid-template-columns:minmax(0,1fr) auto;gap:12px;padding:3px 0}
.viewer .dp-money-row .dp-v{text-align:right;font-weight:600;font-size:14px;font-variant-numeric:tabular-nums}
.viewer .dp-money-row .dp-v.dp-muted{font-size:12px;font-weight:400}
.viewer .dp-money-row.dp-strong{margin-top:6px;padding:8px;background:var(--shell-soft);border:0;border-radius:8px}
.viewer .dp-balance{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px;padding:14px;margin-bottom:10px;border-radius:10px;background:var(--shell-soft)}
.viewer .dp-balance-label{color:var(--shell-muted);font-size:13px}
.viewer .dp-balance-value{font-size:clamp(22px,3vw,30px);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.viewer .dp-balance-value.dp-muted{font-size:14px;font-weight:400}
.viewer .dp-summary-notice{padding:6px 8px;border-left:3px solid var(--shell-warn-text);border-radius:6px;background:var(--shell-warn-bg);color:var(--shell-warn-text);font-size:12px;line-height:1.4}
.viewer .dp-finance-loading,.viewer .dp-finance-error{min-height:0;overflow:auto;padding:12px;border:1px solid var(--shell-line);border-radius:12px}
.viewer .dp-finance-error button{margin-top:8px}
.viewer .dp-strong{font-weight:700}
.viewer .dp-actions{margin:10px 0}
.viewer .dp-go{display:inline-flex;align-items:center;text-decoration:none;border:0;background:${BRAND.primary};color:#fff;border-radius:8px;padding:8px 14px;font:inherit;font-weight:600;cursor:pointer}
.viewer .dp-go:disabled{opacity:.5;cursor:default}
.viewer .dp-tablewrap{overflow:auto;max-width:100%}
.viewer .dp-table{border-collapse:collapse;font-size:12px;width:100%}
.viewer .dp-table th,.viewer .dp-table td{border:1px solid var(--shell-line);padding:4px 6px;text-align:left;vertical-align:top}
.viewer .dp-table th{background:var(--shell-soft);font-weight:600}
.viewer .dp-table td.nw{white-space:nowrap}
.viewer .dp-parties-table :is(th,td){padding:7px 10px;border:0;border-bottom:1px solid var(--shell-line);line-height:1.5;overflow-wrap:anywhere}
.viewer .dp-parties-table tbody tr:last-child td{border-bottom:0}
.viewer .dp-parties-table th{background:var(--shell-soft)}
.viewer .dp-parties-table td:first-child{width:20%;color:var(--shell-muted)}
.viewer .dp-parties-table td.nw{white-space:normal}
.viewer .dp-party-groups{display:flex;flex-direction:column;gap:16px}
.viewer .dp-party-group{min-width:0}
.viewer .dp-party-group-title{display:flex;align-items:center;gap:6px;margin:0;padding:10px;font-size:13px;line-height:1.5;background:var(--shell-soft);border-bottom:1px solid var(--shell-line);overflow-wrap:anywhere}
.viewer .dp-party-count{flex:none;padding:0 6px;border:1px solid var(--shell-line);border-radius:10px;color:var(--shell-muted);font-size:12px;font-weight:400}
.viewer .dp-party-group .dp-parties-table td:first-child{width:44%;color:var(--shell-text)}
.viewer .sf{min-width:0}
.viewer .sf-head{display:flex;gap:14px;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
.viewer .sf-head h3{margin:0 0 7px;font-size:17px}
.viewer .sf-meta{display:flex;gap:6px 14px;align-items:center;flex-wrap:wrap;font-size:12px;line-height:1.5}
.viewer .sf-actions{display:flex;gap:8px;flex-wrap:wrap;flex-shrink:0}
.viewer .sf-actions button{min-height:38px}
.viewer .sf-status{background:var(--shell-soft);border-radius:8px;padding:11px 13px;font-size:12px;line-height:1.6;margin:10px 0}
.viewer .sf-wait{font-size:12px;line-height:1.6;margin:10px 0}
.viewer .sf input[type=search]{box-sizing:border-box;width:100%;margin:8px 0 14px;padding:10px 12px;border:1px solid var(--shell-line);border-radius:8px;background:var(--shell-bg);color:var(--shell-text);font:inherit;font-size:12px}
.viewer .sf-list{min-width:0}
.viewer .sf-empty{padding:24px 16px;border:1px solid var(--shell-line);border-radius:10px;color:var(--shell-muted);font-size:13px;line-height:1.6;text-align:center}
.viewer .sf-table{table-layout:fixed}
.viewer .sf-table :is(th,td){border:0;border-bottom:1px solid var(--shell-line);padding:12px;line-height:1.6;overflow-wrap:anywhere;white-space:pre-wrap}
.viewer .sf-table th:first-child{width:125px}
.viewer .sf-table th:nth-child(2){width:24%}
.viewer .sf-table small{display:block;color:var(--shell-muted);font-size:11px;margin-top:6px}
.viewer .sf-table tbody tr:last-child td{border-bottom:0}
.viewer .sf :is(button,input):focus-visible{outline:2px solid var(--shell-focus);outline-offset:3px}
@container ekran (max-width:600px){.viewer .sf-head{flex-direction:column}.viewer .sf-table thead{display:none}.viewer .sf-table :is(tbody,tr,td){display:block}.viewer .sf-table tr{padding:10px 12px;border:1px solid var(--shell-line);border-radius:9px;margin-bottom:10px}.viewer .sf-table td{padding:5px 0;border:0}.viewer .sf-table td::before{content:attr(data-label) ': ';color:var(--shell-muted);font-size:11px}.viewer .sf-table td.sf-date{color:var(--shell-muted)}}
.viewer .dp-kv div{margin:2px 0}
.viewer .dp-sub{margin:6px 0;padding-left:8px;border-left:2px solid var(--shell-line)}
.viewer .dp-more{margin-top:10px;font-size:12px}
.viewer .gezinme{display:inline-flex;align-items:center;gap:6px}
.viewer .konum{min-width:56px;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}
.viewer .box.ekran{container:ekran/inline-size}
.viewer .ek-banka table{width:100%;border-collapse:collapse;font-size:12px;margin-top:4px}
.viewer .ek-banka-grup{border:1px solid var(--shell-line);border-radius:8px;margin-top:8px;overflow:hidden}
.viewer .ek-banka-grup summary{padding:10px 12px;cursor:pointer;font-weight:600}
.viewer .ek-banka-grup summary small{float:right;margin-left:12px}
.viewer .ek-banka-grup summary:focus-visible{outline:2px solid var(--shell-focus);outline-offset:-2px}
.viewer .ek-banka-grup[open] summary{border-bottom:1px solid var(--shell-line)}
.viewer .ek-banka-grup table{margin:0}
.viewer .ek-banka :is(th,td){text-align:left;padding:4px 6px;border-bottom:1px solid var(--shell-line);vertical-align:top}
.viewer .ek-banka th{color:var(--shell-muted);font-weight:600}
.viewer .ek-banka td:last-child{text-align:right;width:1%;white-space:nowrap}
.viewer .ek-banka .bc-haciz{color:var(--shell-success);font-weight:600}
.viewer .ek-banka .bc-bakiye{color:var(--shell-warn-text)}
.viewer .ek-banka .bc-yok,.viewer .ek-banka .bc-bos{color:var(--shell-muted)}
.viewer .ek-banka .bc-belirsiz{color:var(--shell-warn-text)}
.viewer .ek-banka small{color:var(--shell-muted);font-weight:400}
.viewer .ek-banka-eylem{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:8px}
.viewer .ek-banka-eylem :disabled{opacity:.45;cursor:default}
.viewer :is(.ek-banka,.ek-banka-takip){margin-top:18px;padding:16px;border-radius:12px;min-width:0}
.viewer :is(.ek-banka,.ek-banka-takip)>h4{font-size:14px;margin-bottom:8px}
.viewer .ek-banka-panel>:is(.ek-banka,.ek-banka-takip):first-child{margin-top:0}
.viewer .ek-banka-borclu{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:12px;margin:16px 0!important}
.viewer .ek-banka-borclu>button,.viewer .ek-banka-takip>.ek-banka-eylem>button{min-height:38px}
.viewer .ek-banka-takip>.ek-banka-eylem{gap:8px;margin:12px 0}
.viewer .ek-banka-field{display:flex;flex-direction:column;gap:5px;width:100%;font-size:12px;color:var(--shell-muted)}
.viewer .ek-banka-field select{box-sizing:border-box;width:100%;min-height:36px;max-width:100%;padding:6px 8px;border:1px solid var(--shell-line);border-radius:7px;background:var(--shell-bg);color:var(--shell-text);font:inherit}
.viewer .ek-banka-help{font-size:12px;color:var(--shell-muted);margin-top:12px}
.viewer .ek-banka-help summary{cursor:pointer;width:fit-content;padding:4px 0}
.viewer .ek-banka-help p{margin:8px 0 0;line-height:1.6;max-width:85ch}
.viewer .ek-banka-status{padding:10px 12px;background:var(--shell-soft);border-radius:8px;line-height:1.5;overflow-wrap:anywhere}
.viewer .ek-banka-saved:empty{display:none}
.viewer .ek-banka-saved{display:grid;gap:0;margin-top:12px!important}
.viewer .ek-banka-kayit{display:flex;gap:10px 14px;align-items:center;flex-wrap:wrap;margin:0!important;padding:10px 0;border-bottom:1px solid var(--shell-line)}
.viewer .ek-banka-kayit:last-child{border-bottom:0}
.viewer .ek-banka-kayit b{min-width:140px;overflow-wrap:anywhere}
.viewer .ek-banka-kayit .dp-muted{flex:1;margin:0}
.viewer .ek-banka-kayit button{min-height:32px}
.viewer .ek-banka .ek-banka-eylem{gap:8px;margin:12px 0}
.viewer .ek-banka-grup summary{display:flex;gap:12px;align-items:center;min-height:32px;flex-wrap:wrap}
.viewer .ek-banka-grup summary small{float:none;margin-left:auto}
.viewer .ek-banka-grup :is(th,td){padding:10px 12px;line-height:1.5}
.viewer .ek-banka-grup summary .chip{min-width:54px}
.viewer .ek-banka table td:nth-child(2){overflow-wrap:anywhere}
.viewer .ek-banka .bank-reply-viewed{background:var(--shell-soft)}
.viewer .ek-banka .bank-reply-viewed .bank-reply-mark{color:var(--shell-success);font-weight:600}
.viewer .ek-banka .bank-reply-mark{white-space:nowrap;color:var(--shell-muted)}
.viewer .bank-reply-preview{font:13px/1.4 "Segoe UI",system-ui,sans-serif;padding:0;border:1px solid var(--shell-line);border-radius:12px;width:min(960px,calc(100vw - 32px));height:min(86dvh,900px);max-width:none;max-height:calc(100dvh - 24px);background:var(--shell-bg);color:var(--shell-text);box-shadow:0 20px 55px #10182866}
.viewer .bank-reply-preview[open]{display:flex;flex-direction:column}
.viewer .bank-reply-preview::backdrop{background:#101828aa}
.viewer .bank-reply-preview .bar{flex:none;margin:0}
.viewer .bank-reply-toolbar{flex:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 12px;border-bottom:1px solid var(--shell-line)}
.viewer .bank-reply-toolbar select{flex:1;min-width:180px;max-width:100%;border:1px solid var(--shell-line);border-radius:6px;padding:6px;background:var(--shell-bg);color:var(--shell-text);font:inherit}
.viewer .bank-reply-content{flex:1;min-height:0;display:flex;overflow:auto}
.viewer .bank-reply-content .docview{flex:1;min-width:0}
.viewer .bank-reply-text{padding:16px;white-space:pre-wrap;overflow-wrap:anywhere;margin:0;font:13px/1.6 "Segoe UI",system-ui,sans-serif}
.viewer :is(.dp-summary,.dp-finance,.ek-banka,.ek-banka-takip) :is(button,select,summary):focus-visible{outline:2px solid var(--shell-focus);outline-offset:3px}
.viewer .paket-motor{position:absolute;left:-10000px;top:0;width:1px;height:1px;border:0;opacity:0;pointer-events:none}
.viewer .ek-paket-ac{align-self:flex-start;font-weight:600}
.viewer a.chip{text-decoration:none;display:inline-flex;align-items:center}
.viewer .ek-paket{display:flex;flex-direction:column;gap:6px;padding:8px;border:1px solid var(--shell-accent);border-radius:8px;background:var(--shell-bg);font-size:12px}
.viewer .ek-paket-ust{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:space-between}
.viewer .ek-paket-eylem{display:flex;flex-wrap:wrap;gap:4px;align-items:center}
.viewer .ek-paket .dp-go{padding:4px 10px;font-size:12px}
.viewer .ek-paket :is(button,select):disabled{opacity:.45;cursor:default}
.viewer .ek-paket-sira{font:inherit;font-size:12px;border:1px solid var(--shell-line);border-radius:6px;background:var(--shell-bg);color:var(--shell-text);padding:2px 4px;max-width:100%}
.viewer .ek-paket-durum{color:var(--shell-muted);overflow-wrap:anywhere}
.viewer .ek-paket-durum p{margin:0 0 4px}
.viewer .ek-paket-durum ul{margin:4px 0 0;padding-left:16px}
.viewer .ek-paket-durum li{margin:3px 0}
.viewer .ek-oge.paketli{display:flex;gap:6px;align-items:flex-start}
.viewer .ek-oge.paketli .ek-oge-metin{flex:1;min-width:0}
.viewer .ek-paket-kutu{flex:none;width:16px;height:16px;margin:1px 0 0;accent-color:var(--shell-accent);cursor:pointer}
.viewer .ek-paket-no{flex:none;min-width:20px;padding:0 5px;border-radius:9px;background:var(--shell-accent);color:#fff;font-size:11px;font-weight:700;text-align:center;line-height:18px}
.viewer .ek-paket-panel{padding:16px 18px;overflow:auto;max-width:860px}
.viewer .ek-paket-panel h3{margin:0 0 4px;font-size:15px}
.viewer .ek-paket-liste{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:4px}
.viewer .ek-paket-satir{display:flex;gap:6px;align-items:center;padding:6px 8px;border:1px solid var(--shell-line);border-radius:7px;background:var(--shell-bg)}
.viewer .ek-paket-satir.tasiniyor{border-color:var(--shell-accent);box-shadow:0 3px 10px rgba(0,0,0,.25)}
.viewer .ek-paket-ad{flex:1;min-width:0}
.viewer .ek-paket-ad b{display:block;font-size:12px;overflow-wrap:anywhere}
.viewer .ek-paket-ad small{display:block;color:var(--shell-muted);font-size:11px}
.viewer .ek-paket-tutamak{cursor:grab;touch-action:none}
.viewer .ek-paket-satir :disabled{opacity:.45;cursor:default}
.viewer .ti{max-width:760px;display:flex;flex-direction:column;gap:12px}
.viewer .ti h3{margin:0;font-size:15px}
.viewer .ti p{margin:0}
.viewer .ti-alan{border:1px solid var(--shell-line);border-radius:8px;padding:8px 12px 10px;margin:0;display:flex;flex-direction:column;gap:6px}
.viewer .ti-alan legend{padding:0 4px;font-weight:600}
.viewer .ti-kapsam{display:flex;flex-direction:column;gap:4px}
.viewer .ti-tur-arac{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.viewer .ti-tur-arac input{flex:1;min-width:140px}
.viewer .ti-tur-liste{max-height:220px;overflow:auto;display:flex;flex-direction:column;gap:6px;padding:4px 2px;overscroll-behavior:contain}
.viewer .ti-tur-liste .ti-secenek>span{flex:1;min-width:0;overflow-wrap:anywhere}
.viewer .ti-tur-liste small{font-variant-numeric:tabular-nums}
.viewer .ti-tur :is(select,input[type=search]){box-sizing:border-box;max-width:100%;min-width:0;border:1px solid var(--shell-line);border-radius:7px;padding:9px;background:var(--shell-bg);color:var(--shell-text);font:inherit}
.viewer .ti :is(button,input,select):focus-visible{outline:2px solid var(--shell-focus);outline-offset:2px}
.viewer .ti-secenek{display:flex;gap:8px;align-items:flex-start;cursor:pointer}
.viewer .ti-secenek input{margin:2px 0 0;accent-color:var(--shell-accent)}
.viewer .ti-secenek small{display:block;color:var(--shell-muted)}
.viewer .ti-eylem{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.viewer .ti-eylem :is(button,a):disabled{opacity:.45;cursor:default}
.viewer .ti progress{width:100%;height:8px;accent-color:var(--shell-accent)}
.viewer [hidden]{display:none!important}
.viewer .ek-sekmebar{display:flex;align-items:end;flex-wrap:wrap;gap:6px;padding:8px 12px 0;border-bottom:1px solid var(--shell-line);background:var(--shell-soft)}
.viewer .ek-sekmeler{display:flex;flex-wrap:wrap;gap:4px}
.viewer .ek-notlar{max-width:960px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:16px}
.viewer .ek-not-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.viewer .ek-not-heading h3{margin:0;font-size:18px}
.viewer .ek-not-disclosure{margin:0;color:var(--shell-muted);font-size:12px;line-height:1.65;overflow-wrap:anywhere}
.viewer .ek-not-disclosure p{margin:0 0 6px}
.viewer .ek-not-disclosure p:last-child{margin-bottom:0}
.viewer .ek-not-editor{border:1px solid var(--shell-line);border-radius:12px;background:var(--shell-bg);overflow:hidden;box-shadow:0 2px 8px #00000005}
.viewer .ek-not-editor:focus-within{border-color:var(--shell-focus);box-shadow:0 0 0 2px color-mix(in srgb,var(--shell-focus) 18%,transparent)}
.viewer .note-input{box-sizing:border-box;display:block;width:100%;min-height:clamp(240px,42vh,440px);resize:vertical;overflow:auto;border:0;background:transparent;color:var(--shell-text);padding:22px;font:inherit;font-size:14px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}
.viewer .note-input:empty::before{content:attr(data-placeholder);color:var(--shell-muted);pointer-events:none}
.viewer .note-input:focus-visible{outline:none}
.viewer .note-toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:10px 18px;border-bottom:1px solid var(--shell-line)}
.viewer .note-format{border:1px solid transparent;border-radius:6px;background:transparent;color:var(--shell-text);padding:6px 10px;font:inherit;font-size:12px;cursor:pointer}
.viewer .note-format:hover,.viewer .note-format[aria-pressed=true]{background:var(--shell-soft);border-color:var(--shell-line)}
.viewer .note-format:focus-visible{outline:2px solid var(--shell-focus);outline-offset:2px}
.viewer .note-format:disabled{opacity:.5;cursor:default}
.viewer .note-format[data-format=bold]{font-weight:700}
.viewer .note-red,.viewer .note-format[data-format=red]{color:var(--note-red,#b42318)}
:host([data-theme=dark]) .viewer{--note-red:#ff8f87}
.viewer .ek-not-meta{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:12px 18px;border-top:1px solid var(--shell-line);background:var(--shell-soft)}
.viewer .ek-not-shortcut{font-size:12px;color:var(--shell-muted)}
.viewer .ek-not-actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
.viewer .ek-not-status{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--shell-muted)}
.viewer .ek-not-status::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}
.viewer .ek-not-status.unsaved,.viewer .ek-not-status.pending{color:var(--shell-accent)}
.viewer .ek-not-status.err{color:var(--shell-warn-text)}
.viewer .ek-sekmeler [role=tab]{flex:none;border:1px solid transparent;border-bottom:0;background:none;border-radius:8px 8px 0 0;padding:8px 12px;font:inherit;cursor:pointer;color:var(--shell-text)}
.viewer .ek-sekmeler [role=tab].on{background:var(--shell-bg);border-color:var(--shell-line);color:var(--shell-accent);font-weight:600;margin-bottom:-1px}
.viewer .ek-govde{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--shell-bg)}
.viewer .ek-evrak{--evrak-surface:#f7f9fa;--evrak-selected:color-mix(in srgb,var(--shell-accent) 10%,var(--shell-bg));--evrak-hover:color-mix(in srgb,var(--shell-accent) 5%,var(--shell-bg));--evrak-paper:#eef1f4;flex:1;min-height:0;display:grid;grid-template-columns:clamp(300px,30%,390px) minmax(0,1fr)}
.viewer .ek-evrak.ek-native-document{grid-template-columns:minmax(0,1fr)}
.viewer .ek-liste{display:flex;flex-direction:column;gap:10px;min-width:0;min-height:0;padding:18px 14px 12px;border-right:1px solid var(--shell-line);background:var(--evrak-surface)}
.viewer .ek-gruplar{display:flex;flex-wrap:wrap;gap:4px;padding:3px;border:1px solid var(--shell-line);border-radius:10px;background:var(--shell-bg)}
.viewer .ek-zip-status{color:var(--shell-muted);overflow-wrap:anywhere}
.viewer .ek-zip-status.err{color:var(--shell-warn-text)}
.viewer .chip{border:1px solid var(--shell-line);background:var(--shell-bg);color:var(--shell-text);border-radius:7px;min-height:28px;padding:3px 9px;font:inherit;font-size:12px;cursor:pointer}
.viewer .chip.on{border-color:var(--shell-accent);color:var(--shell-accent);font-weight:600}
.viewer .ek-ara{border:1px solid var(--shell-line);border-radius:7px;padding:6px 8px;font:inherit;background:var(--shell-bg);color:var(--shell-text);min-width:0}
.viewer .ek-ogeler{flex:1;min-height:0;overflow:auto;overflow-anchor:none;overscroll-behavior:contain;scrollbar-gutter:stable;display:flex;flex-direction:column;gap:6px;border-radius:8px;padding:2px 2px 6px}
    .viewer .ek-ogeler:focus-visible{outline:2px solid var(--shell-focus);outline-offset:1px}
    .viewer .ek-liste-arac{display:flex;gap:6px;flex-wrap:wrap;align-items:center;min-width:0}
    .viewer .ek-liste-arac .ek-ara{flex:1 1 140px;min-width:0;width:0}
    .viewer .ek-liste-arac .chip{flex:none;min-height:34px;padding:5px 9px;background:transparent;border-color:transparent;color:var(--shell-muted)}
    .viewer .ek-kategori{flex:none;min-width:0;border-bottom:1px solid var(--shell-line);padding-bottom:4px}
    .viewer .ek-kategori-baslik{display:flex;align-items:flex-start;gap:9px;list-style:none;padding:11px 9px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}
    .viewer .ek-kategori-baslik::-webkit-details-marker{display:none}
    .viewer .ek-kategori-ok{flex:none;width:8px;margin-top:1px;transition:transform .12s}
    .viewer .ek-kategori[open]>.ek-kategori-baslik .ek-kategori-ok{transform:rotate(90deg)}
    .viewer .ek-klasor{flex:none;width:15px;height:11px;margin-top:4px;border:1.5px solid currentColor;border-radius:2px;position:relative;opacity:.8}
