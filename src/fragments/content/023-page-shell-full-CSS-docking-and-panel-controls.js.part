    if (!text && !style) return style;
    if (!style) style = document.createElement('style');
    if (style.textContent !== text) style.textContent = text;
    if (!style.isConnected) document.documentElement.append(style);
    return style;
  }
  function fitDockedModals() {
    const sizes = [], places = [], items = [];
    if (dockOverlay && panel && !panel.hidden) {
      const { base } = dockOverlay, aw = dockOverlay.availableWidth / base, vh = innerHeight / base, gap = 8 / base;
      const open = new Set([...document.querySelectorAll(DOCK_MODAL_CONTENT)].filter(c => c.getClientRects().length));
      for (const content of [...dockModalSeen]) {
