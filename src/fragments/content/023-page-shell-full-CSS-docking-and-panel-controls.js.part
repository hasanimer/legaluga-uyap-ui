  // DevExtreme fare ve odak durumunu sınıfla değiştirir; bunlar sayfanın yerleşimini değiştirmez.
  // Diğer sınıflar, stiller ve yeni/kaldırılan öğeler eskisi gibi tam ölçümü tetikler.
  function dockLayoutRecord(record) {
