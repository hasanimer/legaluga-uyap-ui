    } catch { /* Sonraki aralıkta yeniden denenir. */ }
    finally { if (sessionPingController === controller) sessionPingController = null; }
  }
  if (typeof sessionRequestHooks !== 'undefined') sessionRequestHooks = {
    invalidate: abortSessionPing, preferencesChanged: sessionPreferencesChanged
  };
  setInterval(() => { void sessionPing(); }, YOKLAMA_MS);
  window.addEventListener('storage', event => {
    if (event.key === 'loginState') { sessionRevision++; sessionLoginState = null; abortSessionPing(); }
  });
  window.addEventListener('offline', abortSessionPing);
  window.addEventListener('pagehide', () => { sessionDisposed = true; abortSessionPing(); });
  window.addEventListener('pageshow', () => { sessionDisposed = false; });
})();
