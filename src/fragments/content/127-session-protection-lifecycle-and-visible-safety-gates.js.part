  const YOKLAMA_MS = 2 * 60000;
  let sessionPingController = null, sessionDisposed = false;
  let sessionRevision = 0, sessionLoginState = null;
  let sessionScanBlocked = false, sessionScanStateRevision = 0;
  const keepAliveOn = () => pagePrefs.oturumAcik !== false;
  function isLoginPage() {
    if (/^\/(giris|cikis|edevletlogin|testlogin|autologin)(\/|$)|^\/(web1|login)\.uyap(\/|$)/i.test(location.pathname)) return true;
    // E-imza penceresi SPA içinde açıkken eski giriş bayrağı kalabilir. PIN değerini okumayız.
    return [...document.querySelectorAll('.login-page, .login-menu-root, input[type="password"][name="password"][placeholder="Pin Kodu"]')].some(visible);
  }
  // Kurulumun bağlantı önbelleği önceki girişteki yanıtı yeni oturuma taşıyamaz.
  const inSession = () => {
    const active = localStorage.getItem('loginState') === 'true' && !isLoginPage() &&
      !!document.getElementById('av-sidebar-wrapper')?.isConnected;
    if (sessionLoginState !== null && active !== sessionLoginState) { sessionRevision++; abortSessionPing(); }
    sessionLoginState = active;
    return active;
  };
  const sessionGone = error => error.status === 401 || ['PRTL_GNL_100026', 'giris-sayfasi', 'baska-oturum'].includes(error.code);
  function canProtect() {
    if (!keepAliveOn() || !inSession() || contextGone || sessionDisposed || sessionScanBlocked || navigator.onLine === false) return false;
    try { return !!chrome.runtime?.id; } catch { return false; }
  }
  function abortSessionPing() { sessionPingController?.abort(); }
  function sessionPreferencesChanged() { if (!keepAliveOn()) abortSessionPing(); }
