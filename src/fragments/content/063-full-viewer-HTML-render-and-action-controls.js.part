
    function bankDraw() {
      if (!bankCard || closed) return;
      const { select, load, query, requests, stop, status, rows } = bankCard;
      const busy = bankBusy();
      select.disabled = busy; load.disabled = busy;
      query.disabled = busy || !bankLive(); requests.disabled = busy || !bankSubjects[bankSelected];
      stop.hidden = !bankRun; stop.disabled = !bankRun;
      const snapshot = bankSubjects[bankSelected];
      load.textContent = bankBorrowers.length ? 'Borçluları yenile' : 'Borçluları getir';
      status.textContent = bankNotice || (snapshot ? `${snapshot.debtorLabel} · Sorgu: ${snapshot.queryDate || 'tarih bilinmiyor'} · ${snapshot.banks.length} banka. Kaydedilen sorgu sonucu.` : bankLive() ? `${bankLive().label} seçili. Güncel banka bilgileri için “Bankaları sorgula”ya basın.` : 'Başlamak için borçluları getirin ve bir borçlu seçin.');
      rows.replaceChildren();
      if (!snapshot) return;
      if (!snapshot.banks.length) rows.append(el('p', { class: 'dp-muted' }, 'Bu sorguda banka kaydı dönmedi.'));
      for (const row of snapshot.banks) rows.append(el('div', { class: 'ek-banka-kayit' }, el('b', null, row.name)));
      const requestDocuments = snapshot.requests.filter(proof => proof.subjectVerified === true && snapshot.banks.some(row => bankaAdi(row.key || row.name) === bankaAdi(proof.bank)))
        .map(proof => ({ proof, document: tum.find(x => bankOwn(x) && bankKey(x) === proof.evrakKey) }));
      if (requestDocuments.length || snapshot.coverage.requests !== 'unknown') {
        const requestList = el('div', { class: 'ek-banka-talep-list', 'data-bank-check': 'request-list' },
          el('b', null, `Kaydedilen talep kontrolü: ${requestDocuments.length} doğrulanan evrak`));
        for (const { proof, document: item } of requestDocuments) {
          const open = el('button', { type: 'button', class: 'chip', disabled: busy || !item, ...(item ? { 'data-bank-request': bankKey(item) } : {}) }, 'Talebi aç');
          if (item) open.addEventListener('click', () => bankaAc(item));
          requestList.append(el('div', { class: 'ek-banka-kayit' }, el('span', null, `${item?.tur || 'Evrak bu listede bulunamadı'} · ${tarihYaz(item?.onay || proof.date)} · ${proof.bank}`), open));
        }
        requestList.append(el('p', { class: 'dp-muted' }, 'Yalnız dosya, borçlu ve muhatap banka doğrulanan talep kayıtları listelenir. Kayıt bulunmaması talebin gönderilmediğini kanıtlamaz.'));
        rows.append(requestList);
      }
    }
    
