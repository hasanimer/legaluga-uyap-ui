
    function bankaCiz() {
      bankDraw();
      if (!bankaKart || closed) return;
      const { govde, durum, oku, durdur } = bankaKart;
      const busy = bankBusy();
      oku.disabled = busy; oku.hidden = false; oku.textContent = 'Listeyi yenile';
      oku.title = 'Yalnız dosyanın evrak listesini yeniler; banka sorgusu veya cevap metni analizi yapmaz.';
      durdur.hidden = !bankaOkuma; durdur.disabled = !!bankaOkuma?.ac.signal.aborted;
      if (!kaynak) {
        durum.textContent = listeBekliyor ? 'Evrak listesi UYAP’tan alınıyor…' : 'Cevap listesi henüz alınamadı. Listeyi yenile’ye basın.';
        govde.replaceChildren(); return;
      }
      if (kaynak.list.kilit) { durum.textContent = 'UYAP: ' + kaynak.list.kilit; govde.replaceChildren(); return; }
      const satirlar = bankaSatirlari();
      const viewed = satirlar.filter(s => bankViewed.has(bankViewKey(s.x))).length;
      durum.textContent = bankaOkuma ? bankaOkuma.yazi : bankaHata ? bankaHata
        : satirlar.length ? fmtNum(satirlar.length) + (kaynak.list.morePages ? '+ cevap listelendi' : ' cevap') + ' · ' + fmtNum(viewed) + ' görüntülendi. Özgün başlıklar ve tarihler gösteriliyor.'
          : kaynak.list.morePages ? 'Bu sayfada banka cevabı yok. Tam liste için Listeyi yenile’ye basın.' : 'Bu dosyada banka cevabı yok.';
      const expanded = new Set([...govde.querySelectorAll('.ek-banka-grup')].filter(group => group.open).map(group => group.dataset.banka));
      const scrollTop = govde.scrollTop;
      const gruplar = new Map();
      for (const { x } of satirlar) {
        const name = bankaAdi(x.gonderen || '') || x.gonderen || 'Gönderen belirtilmemiş';
        const key = norm(name);
        if (!gruplar.has(key)) gruplar.set(key, { key, name, replies: [] });
        gruplar.get(key).replies.push(x);
      }
      govde.replaceChildren(...[...gruplar.values()].sort((a, b) => a.name.localeCompare(b.name, 'tr')).map(({ key, name, replies }) => {
        const group = el('details', { class: 'ek-banka-grup', 'data-banka': key },
          el('summary', null, name, el('small', null, fmtNum(replies.length) + ' cevap')),
          el('table', null, el('thead', null, el('tr', null, ['Tarih', 'Evrak', 'Durum', ''].map(text => el('th', { scope: 'col' }, text)))),
            el('tbody', null, replies.map(x => {
              const opened = bankViewed.has(bankViewKey(x));
              const open = el('button', { type: 'button', class: 'chip', title: 'Özgün evrakı banka sekmesinden ayrılmadan aç', 'data-bank-reply': bankViewKey(x) }, 'Cevabı aç');
              open.disabled = busy;
              open.addEventListener('click', () => bankaAc(x));
              return el('tr', { class: opened ? 'bank-reply-viewed' : '', 'data-bank-viewed': String(opened) }, el('td', null, tarihYaz(x.onay)),
                el('td', null, x.tur), el('td', { class: 'bank-reply-mark' }, opened ? '✓ Görüntülendi' : '-'), el('td', null, open));
            }))));
        group.open = bankaTumAcik || expanded.has(key);
        const toggle = el('button', { type: 'button', class: 'chip ek-banka-grup-ac', 'aria-label': name + ' cevaplarını ' + (group.open ? 'kapat' : 'aç'), 'aria-expanded': String(group.open) }, group.open ? 'Kapat' : 'Aç');
        const update = () => { toggle.textContent = group.open ? 'Kapat' : 'Aç'; toggle.setAttribute('aria-expanded', String(group.open)); toggle.setAttribute('aria-label', name + ' cevaplarını ' + (group.open ? 'kapat' : 'aç')); };
        toggle.addEventListener('click', event => { event.preventDefault(); event.stopPropagation(); group.open = !group.open; bankaTumAcik = false; update(); });
        group.addEventListener('toggle', () => { if (govde.contains(group)) update(); });
        group.children[0].append(toggle);
        return group;
      }));
      govde.scrollTop = scrollTop;
    }

    function bankaBekle(signal, promise) {
      return new Promise((resolve, reject) => {
        const iptal = () => reject(new DOMException('Durduruldu.', 'AbortError'));
        if (signal.aborted) { iptal(); return; }
        signal.addEventListener('abort', iptal, { once: true });
        Promise.resolve(promise).then(resolve, reject).finally(() => signal.removeEventListener('abort', iptal));
      });
    }
    // Tebligat anahtarı liste yenilense de aynı kalır; UYAP evrak ve ek kimliklerini yanıttan yanıta değiştirebilir. Ana evrak
    // ve ayrı satırdaki ek kendi evrak anahtarıyla, yalnız ek listesindeki ek ana evrak ve ek adıyla tanınır. Aynı ana evrakta
    // aynı adlı birden fazla ek (ör. iki muhatabın zarfı) adla ayrılamaz: bu ikizler listenin verdiği ek kimliğini de taşır.
    // Sıra kullanılmaz; yenilenen listede sıra değişince anahtar başka eke kaymamalı. Kimlik yenilenirse ikizin eski anahtarı düşer.
    const tebligatKey = x => {
      if (x.ekIndis == null) return JSON.stringify([x.k, x.dosya]);
      const ekler = Array.isArray(x.ana.e?.ekEvrakListesi) ? x.ana.e.ekEvrakListesi : [];
      const ikiz = ekler.filter((ek, j) => ek && typeof ek === 'object' && (String(ek.ekTuru ?? '').trim() || `Ek ${j + 1}`) === x.tur).length > 1;
      return JSON.stringify(ikiz ? [x.ana.k, x.dosya, 'ek', x.tur, String(x.ekId ?? '')] : [x.ana.k, x.dosya, 'ek', x.tur]);
    };
    const tebligatTuru = x => /^(?:acik|kapali)?e?teblig(?:at)?(?:mazbatasi)?(?:evraki|belgesi)?$/.test(norm(x.tur).replace(/[^a-z0-9]/g, ''));
    // Okunabilen tebligat: ana evrak ve ayrı satırdaki ek kendi UYAP kimliğiyle, yalnız ek listesindeki ek ana evrakın verdiği ek
    // kimliğiyle alınır. Kimliksiz kayıt hedef olmaz; seçici onu listelenemeyen kayıt olarak sayar.
    const tebligatEligible = x => tebligatTuru(x) && !!x.k && (x.ekIndis != null ? paketAlinir(x) : x.e?.evrakId != null && x.e.evrakId !== '');
    const tebligatUets = x => /^(?:acik|kapali)?eteblig(?:at)?(?:mazbatasi)?(?:evraki|belgesi)?$/.test(norm(x.tur).replace(/[^a-z0-9]/g, ''));
    const tebligatComplete = () => !!kaynak && !kaynak.list.kilit && !kaynak.list.morePages && !kaynak.list.scopeUnknown;
    
