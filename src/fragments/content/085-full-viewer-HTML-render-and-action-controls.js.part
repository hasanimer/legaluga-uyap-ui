
    function bankaCiz() {
      bankDraw();
      if (!bankaKart || closed) return;
      const { govde, durum, oku, durdur } = bankaKart;
      if (!kaynak) {
        durum.textContent = listeBekliyor ? 'Evrak listesi UYAP’tan alınıyor…' : `Evrak listesi alınamadı${listeHata ? ': ' + listeHata : '.'}`;
        govde.replaceChildren(); oku.hidden = !!listeBekliyor || !!bankaOkuma; oku.textContent = 'Listeyi tekrar al';
        oku.title = `Evrak listesini UYAP’tan tekrar alır.\n\n${BANKA_OKUMA_ACIKLAMASI}`;
        oku.setAttribute('aria-description', oku.title);
        oku.disabled = !!bankRun || !!paketSession || !!zipRun || !!tebligatRead; durdur.hidden = !bankaOkuma; return;
      }
      if (kaynak.list.kilit) { durum.textContent = `UYAP: ${kaynak.list.kilit}`; govde.replaceChildren(); oku.hidden = true; durdur.hidden = true; return; }
      const satirlar = bankaSatirlari();
      const sonuclar = satirlar.map(s => bankaSonuc.get(paketAnahtar(s.x))).filter(r => r && !r.hata);
      const say = n => sonuclar.filter(r => r.sonuc === n).length;
      const ustYazi = sonuclar.filter(r => r.sonuc === 'belirsiz' && r.ustYazi && !r.adaylar.length).length;
      const ozet = [say('haciz') && `${say('haciz')} haciz işlendi`, say('bakiyeYok') && `${say('bakiyeYok')} bakiye yok`,
        say('yok') && `${say('yok')} kayıt yok`, say('belirsiz') - ustYazi && `${say('belirsiz') - ustYazi} anlaşılamadı`,
        ustYazi && `${ustYazi} yalnız üst yazı`].filter(Boolean).join(', ');
      durum.textContent = bankaOkuma ? bankaOkuma.yazi
        : bankaHata ? `Okuma durdu: ${bankaHata}`
          : sonuclar.length ? `${fmtNum(satirlar.length)} cevap: ${ozet}.`
            : !satirlar.length ? (kaynak.list.morePages ? 'Evrak listesinin ilk sayfasında banka cevabı yok; diğer sayfalar kontrol edilebilir.' : 'Bu dosyada banka cevabı yok.')
              : `${fmtNum(satirlar.length)} cevap. Bankanın ne cevap verdiğini görmek için “Cevapları oku”ya basın.`;
      if (!bankaOkuma && !bankaHata && bankReplyNotice) durum.textContent += ` ${bankReplyNotice}`;
      const acikBankalar = new Set([...govde.querySelectorAll('.ek-banka-grup')].filter(g => g.open).map(g => g.dataset.banka));
      const gruplar = new Map();
      for (const { x } of satirlar) {
        const r = bankaSonuc.get(paketAnahtar(x));
        const ad = bankaAdi(r?.banka || x.gonderen || '') || r?.banka || 'Banka belirlenemedi';
        const key = norm(ad);
        if (!gruplar.has(key)) gruplar.set(key, { key, ad, cevaplar: [] });
        gruplar.get(key).cevaplar.push(x);
      }
      govde.replaceChildren(...[...gruplar.values()].sort((a, b) =>
        (a.ad === 'Banka belirlenemedi') - (b.ad === 'Banka belirlenemedi') || a.ad.localeCompare(b.ad, 'tr')
      ).map(({ key, ad, cevaplar }) => {
        const grup = el('details', { class: 'ek-banka-grup', 'data-banka': key },
          el('summary', null, ad, el('small', null, `${fmtNum(cevaplar.length)} cevap`)),
          el('table', null,
        el('thead', null, el('tr', null, el('th', null, 'Tarih'), el('th', null, 'Cevap'), el('th', null, ''))),
        el('tbody', null, cevaplar.map(x => {
          const r = bankaSonuc.get(paketAnahtar(x));
          const [etiket, sinif] = r && !r.hata
            ? r.ustYazi && !r.adaylar.length ? ['Yalnız üst yazı; asıl cevap yok', 'bc-belirsiz'] : BANKA_SONUC[r.sonuc]
            : [r?.hata ? 'Alınamadı' : '—', r?.hata ? 'bc-belirsiz' : 'bc-bos'];
          const ac = el('button', { type: 'button', class: 'chip', title: 'Cevabın veya tutarın yazılı olduğu asıl belgeyi aç' }, 'Cevabı aç');
          ac.disabled = !!bankRun || !!paketSession || !!zipRun || !!tebligatRead;
          ac.addEventListener('click', () => bankaAc(x));
          return el('tr', null, el('td', null, tarihYaz(x.onay)),
            el('td', { class: sinif }, etiket, r && r.sonuc === 'haciz' && r.tutar ? el('b', null, ` · ${r.tutar}`) : null,
              r && r.oncekiHaciz ? el('small', null, ' · önceki hacizler var') : null,
              r?.hata ? el('small', null, ` · ${r.hata}`) : null),
            el('td', null, ac));
        }))));
        grup.open = bankaTumAcik || acikBankalar.has(key);
        const acKapat = el('button', { type: 'button', class: 'chip ek-banka-grup-ac', 'aria-label': `${ad} cevaplarını ${grup.open ? 'kapat' : 'aç'}`, 'aria-expanded': String(grup.open) }, grup.open ? 'Kapat' : 'Aç');
        const durumYaz = () => {
          acKapat.textContent = grup.open ? 'Kapat' : 'Aç';
          acKapat.setAttribute('aria-expanded', String(grup.open));
          acKapat.setAttribute('aria-label', `${ad} cevaplarını ${grup.open ? 'kapat' : 'aç'}`);
        };
        acKapat.addEventListener('click', ev => { ev.preventDefault(); ev.stopPropagation(); grup.open = !grup.open; bankaTumAcik = false; durumYaz(); });
        grup.addEventListener('toggle', () => { if (!govde.contains(grup)) return; if (!grup.open) bankaTumAcik = false; durumYaz(); });
        grup.children[0].append(acKapat);
        return grup;
      }));
      const kalan = satirlar.filter(s => !bankaSonuc.has(paketAnahtar(s.x)) || bankaSonuc.get(paketAnahtar(s.x)).hata);
      const istek = kalan.reduce((n, s) => n + 1 + s.ekler.length, 0);
      oku.hidden = !!bankaOkuma || (!kalan.length && !kaynak.list.morePages);
      oku.textContent = !satirlar.length && kaynak.list.morePages ? 'Cevapları bul ve oku' : sonuclar.length ? `Kalanları oku (${fmtNum(kalan.length)})` : 'Cevapları oku';
      oku.disabled = !!bankRun || !!paketSession || !!zipRun || !!tebligatRead;
      const okumaDurumu = bankRun ? 'Banka sorgusu veya talep kontrolü sürerken okunamaz.' : paketSession ? 'Duruşma paketi hazırlanırken okunamaz.' : zipRun ? 'ZIP indirmesi sürerken okunamaz.'
        : `${fmtNum(istek)} evrak (gelen banka cevapları ve ekleri); yaklaşık ${Math.max(1, Math.round(istek * (BANKA_ARALIK + 400) / 60000))} dakika sürer.`;
      oku.title = `${okumaDurumu}\n\n${BANKA_OKUMA_ACIKLAMASI}`;
      oku.setAttribute('aria-description', oku.title);
      durdur.hidden = !bankaOkuma;
      durdur.disabled = !!bankaOkuma?.ac.signal.aborted;
    }
    function bankaBekle(signal, promise) {
      return new Promise((resolve, reject) => {
        const iptal = () => reject(new DOMException('Durduruldu.', 'AbortError'));
        if (signal.aborted) { iptal(); return; }
        signal.addEventListener('abort', iptal, { once: true });
        Promise.resolve(promise).then(resolve, reject).finally(() => signal.removeEventListener('abort', iptal));
      });
    }
    const tebligatKey = x => JSON.stringify(x.ana ? [x.ana.k, x.dosya, 'ek', x.tur] : [x.k, x.dosya]);
    const tebligatEligible = x => {
      const title = norm(x.tur).replace(/[^a-z0-9]/g, '');
      return /^(?:acik|kapali)?e?teblig(?:at)?(?:mazbatasi)?(?:evraki|belgesi)?$/.test(title) && paketAlinir(x) &&
        (x.ana || x.e?.evrakId != null && x.e.evrakId !== '');
    };
    const tebligatUets = x => /^(?:acik|kapali)?eteblig(?:at)?(?:mazbatasi)?(?:evraki|belgesi)?$/.test(norm(x.tur).replace(/[^a-z0-9]/g, ''));
    const tebligatComplete = () => !!kaynak && !kaynak.list.kilit && !kaynak.list.morePages && !kaynak.list.scopeUnknown;
    