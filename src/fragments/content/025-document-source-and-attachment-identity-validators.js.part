  function evrakBul(list, key, group, index) {
    const candidates = index?.list === list && index.count === list.length && index.byKey instanceof Map
      ? index.byKey.get(key) || [] : list.filter(x => evrakKey(x) === key);
    const grouped = group ? candidates.filter(x => x.dosyaGrubu === group) : [];
    // Son 20 yanıtı grup taşımayabilir; açık bir hedef başka bilinen dosya grubuna taşınmaz.
    const unknown = group ? candidates.filter(x => !x.dosyaGrubu) : [];
    const matches = grouped.length ? grouped : group ? unknown : candidates;
    if (matches.length > 1) throw kimlikHatasi('Aynı bilgileri taşıyan birden fazla evrak var; yanlış evrakı açmamak için dosyayı UYAP’ta açın.');
    if (!matches[0]) throw kimlikHatasi('Evrak dosyanın evrak listesinde bulunamadı; Güncelle’ye basıp tekrar deneyin.');
    return matches[0];
  }

  // İndirme okuyucusunun kendi liste kopyası: adaylar korunur; aynı anahtar tek evraka indirgenmez.
  function evrakIndeksi(list) {
    const rows = list.map(row => row && typeof row === 'object' ? { ...row,
      ...(Array.isArray(row.ekEvrakListesi) ? { ekEvrakListesi: row.ekEvrakListesi.map(item => item && typeof item === 'object' ? { ...item } : item) } : {}) } : row);
    const byKey = new Map();
    rows.forEach(row => {
      const key = evrakKey(row), candidates = byKey.get(key) || [];
      candidates.push(row); byKey.set(key, candidates);
    });
    return { list: rows, count: rows.length, byKey };
  }

  // Yalnız ana evrakın ekEvrakListesi'nde olan ek (1.19.4): ana evrak anahtarıyla bulunur, ek sırasıyla alınır. UYAP'ın ek
  // düğümü gibi görüntüleme adresine ekin kendi evrakId'si ve ana evrakın dosya kimliği verilir.
  function ekBul(list, hedef, index) {
    const ana = evrakBul(list, hedef.ana.k, hedef.ana.dosya, index);
    const liste = Array.isArray(ana.ekEvrakListesi) ? ana.ekEvrakListesi : [];
    // Önce ilk listedeki kimlik aranır; aynı adlı ekler sırayla eşleştirilmez. UYAP bütün kimlikleri
    // yenilediyse yalnız ana evrakın kimlik değişimi ve iki listedeki tek açık ek adı birlikte yeterlidir.
    const ad = k => String((k && k.ekTuru) || '').trim();
    const ilkAna = hedef.ana.e;
    const ilkListe = Array.isArray(ilkAna?.ekEvrakListesi) ? ilkAna.ekEvrakListesi : [];
    const kimlik = hedef.ekId ?? hedef.ana.e?.ekEvrakListesi?.[hedef.ekIndis]?.evrakId;
    let ek, kimlikEksik = true;
    if (kimlik != null && kimlik !== '') {
      const aynilar = liste.filter(k => k && String(k.evrakId) === String(kimlik));
      kimlikEksik = aynilar.length === 0;
      ek = aynilar.length === 1 ? aynilar[0] : null;
    }
    const anaKimligiYenilendi = ilkAna?.evrakId != null && ilkAna.evrakId !== '' && ana.evrakId != null && ana.evrakId !== '' &&
      String(ilkAna.evrakId) !== String(ana.evrakId) && evrakKey(ilkAna) === evrakKey(ana) &&
      String(ilkAna.dosyaGrubu || '') === String(ana.dosyaGrubu || '');
    if (!ek && kimlikEksik && anaKimligiYenilendi) {
      const beklenenAd = String(hedef.tur || '').trim();
      const ilkAynilar = ilkListe.filter(k => ad(k) && ad(k) === beklenenAd);
      const yeniAynilar = liste.filter(k => ad(k) && ad(k) === beklenenAd);
      if (ilkAynilar.length === 1 && yeniAynilar.length === 1 &&
          (kimlik == null || kimlik === '' || String(ilkAynilar[0].evrakId) === String(kimlik))) ek = yeniAynilar[0];
    }
    // UYAP'ın kimliksiz verdiği ek (evrakId'siz) hiçbir listede açılamaz; ayrı ve anlaşılır iletiyle bildirilir.
    const ilkEk = ilkListe[hedef.ekIndis];
    const kimliksizEk = ek ? ek.evrakId == null || ek.evrakId === '' :
      (kimlik == null || kimlik === '') && !!ilkEk && typeof ilkEk === 'object' && (ilkEk.evrakId == null || ilkEk.evrakId === '');
    if (kimliksizEk) throw kimlikHatasi('Ek, UYAP’ta açılabilir bir kimlikle verilmiyor; eki UYAP’ta açmayı deneyin.', true);
    if (!ek) throw kimlikHatasi('Ek, ana evrakın ek listesinde bulunamadı; Güncelle’ye basıp tekrar deneyin.', true);
    return { evrakId: ek.evrakId, dosyaId: ana.dosyaId, dosyaGrubu: ana.dosyaGrubu, tur: hedef.tur, onaylandigiTarih: ana.onaylandigiTarih };
  }

  // Kayıtlı hedefin listedeki kimliği kesin çözülemedi (bulunamadı, belirsiz veya kimliksiz). Toplu indirme bu türü
  // yalnız taze ve tam listeyle doğrulandığında atlar; tek evrak görünümü iletiyi olduğu gibi gösterir.
  // anaBulundu: ana evrak listede tek ve kesin bulundu; ek listesi ana evrakla birlikte geldiğinden sayfa kapsamından bağımsızdır.
  function kimlikHatasi(message, anaBulundu = false) {
    return Object.assign(new Error(message), { kind: 'kimlik' }, anaBulundu ? { anaBulundu: true } : {});
  }
