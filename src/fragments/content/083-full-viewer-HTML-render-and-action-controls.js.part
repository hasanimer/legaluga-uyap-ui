
    function bankCardAdd(p) {
      if (!bankChecks || !bankAPI || !globalThis.UHDStorage?.mergeBankCheck) return;
      if (!bankCard) {
        const attr = (key, extra = {}) => ({ 'data-bank-check': key, ...extra });
        const select = el('select', attr('debtor', { 'aria-label': 'Banka sorgusu yapılacak borçlu' }), el('option', { value: '' }, 'Borçlu seçin'));
        const load = el('button', attr('load', { type: 'button', class: 'chip' }), 'Borçluları getir');
        const query = el('button', attr('query', { type: 'button', class: 'dp-go', disabled: true }), 'Bankaları sorgula');
        const requests = el('button', attr('requests', { type: 'button', class: 'chip', disabled: true, title: 'Kaydedilen banka sorgusunu dosyanın talep evraklarıyla karşılaştırır; talep göndermez.' }), 'Talepleri kontrol et');
        const stop = el('button', attr('stop', { type: 'button', class: 'chip', hidden: true }), 'Durdur');
        const status = el('div', attr('status', { class: 'dp-muted ek-banka-status', role: 'status', 'aria-live': 'polite' }));
        const rows = el('div', attr('rows', { class: 'ek-banka-saved' }));
        bankCard = { select, load, query, requests, stop, status, rows,
          el: el('div', { class: 'dp-card ek-banka-takip' }, el('h4', null, 'Borçlu ve banka sorgusu'),
            el('p', { class: 'dp-muted' }, 'Borçluyu seçip bankalarını sorgulayın. UYAP ücret ve limitleri geçerlidir; ücret varsa sorgudan önce onayınız istenir.'),
            el('div', { class: 'ek-banka-borclu' }, el('label', { class: 'ek-banka-field' }, 'Borçlu', select), load),
            el('div', { class: 'ek-banka-eylem' }, query, requests, stop), status, rows,
            el('details', { class: 'ek-banka-help' }, el('summary', null, 'Sorgu ve kayıt hakkında'),
              el('p', null, 'Banka listesi ve evrak özetleri bu Chrome profilinde şifreli saklanır. Cevap bulunmaması talep gönderilmediğini kanıtlamaz. Talep kontrolü evrak kaydını inceler; talep göndermez.'))) };
        load.addEventListener('click', bankLoadBorrowers); query.addEventListener('click', bankQuery); requests.addEventListener('click', bankScanRequests);
        select.addEventListener('change', () => { bankSelected = select.value; bankNotice = ''; bankDraw(); });
        stop.addEventListener('click', () => bankRun?.ac.abort());
        chrome.storage.local.get('uhdBankChecks').then(({ uhdBankChecks }) => {
          if (closed || !uhdBankChecks) return;
          const saved = bankChecks.sanitizeStore(uhdBankChecks).files[rec.key]?.subjects || {};
          for (const [key, snapshot] of Object.entries(saved)) if (!bankSubjects[key] || bankSubjects[key].at < snapshot.at) bankSubjects[key] = snapshot;
          if (!bankBorrowers.length) {
            select.replaceChildren(el('option', { value: '' }, 'Borçlu seçin'), ...Object.values(bankSubjects).map(s => el('option', { value: s.debtorKey }, s.debtorLabel)));
            const keys = Object.keys(bankSubjects); bankSelected = keys.length === 1 ? keys[0] : ''; select.value = bankSelected;
          }
          bankDraw();
        }).catch(() => { bankNotice = 'Şifreli banka kaydı açılamadı. Önce yerel kasa sorununu giderin.'; bankDraw(); });
      }
      p.append(bankCard.el); bankDraw();
    }
    const bankaSatirlari = () => tum.filter(x => !x.ana && !x.yetimEk && ihbarCevabiMi(x.tur))
      .map(x => ({ x, ekler: tum.filter(e => e.ana && e.ana.k === x.k && e.ana.dosya === x.dosya && !/dosyaBilgileri/i.test(e.tur)) }));
    function bankReplyClose(restore = true) {
      const state = bankReplyPopupState;
      if (!state) return;
      bankReplyPopupState = null; bankReplyPopup = null;
      state.ac.abort(); state.readAc?.abort(); state.render?.birak();
      for (const url of state.urls) URL.revokeObjectURL(url);
      if (state.dialog.open) state.dialog.close();
      state.dialog.remove();
      if (!closed) { bankaCiz(); zipSync(); }
      if (restore) {
        const previous = state.previous?.isConnected ? state.previous : Array.from(shadowRoot.querySelectorAll('button')).find(button => state.previousKey && [button.getAttribute('data-bank-reply'), button.getAttribute('data-bank-request')].includes(state.previousKey));
        previous?.focus({ preventScroll: true });
      }
    }
    async function bankReplyRender(state, target, sourceEntry) {
      state.readAc?.abort(); state.render?.birak(); state.render = null;
      for (const url of state.urls) URL.revokeObjectURL(url);
      state.urls.clear();
      const ac = state.readAc = new AbortController();
      const valid = () => !closed && bankReplyPopupState === state && state.readAc === ac && !state.ac.signal.aborted && !ac.signal.aborted;
      state.content.replaceChildren(el('div', { class: 'msg', role: 'status' }, 'Özgün cevap evrakı alınıyor…'));
      state.download.hidden = true;
      state.select.disabled = true; state.sourceSelect.disabled = true;
      try {
        let doc;
        if (sourceEntry) doc = sourceEntry.doc;
        else {
          doc = await bankaOku(target, ac.signal);
          if (!valid()) return;
          state.target = target; state.sourceDocs = [];
          state.sourceSelect.replaceChildren(); state.sourceSelect.hidden = true;
          if (doc?.archiveSources?.length) {
            state.sourceDocs = [{ ad: 'Paketin tamamı', doc }, ...doc.archiveSources];
            state.sourceSelect.replaceChildren(...state.sourceDocs.map((entry, i) => el('option', { value: String(i) }, entry.ad)));
            state.sourceSelect.hidden = false; state.sourceSelect.value = '1';
            sourceEntry = state.sourceDocs[1]; doc = sourceEntry.doc;
          }
        }
        if (!valid()) return;
        if (!doc?.blob || !doc.blob.size) throw new Error('Özgün cevap evrakı alınamadı.');
        const ext = documentExtension(doc), label = `${target.tur} · ${tarihYaz(target.onay)}${sourceEntry ? ` · ${sourceEntry.ad}` : ''}`;
        const saveUrl = URL.createObjectURL(new Blob([doc.blob], { type: 'application/octet-stream' }));
        state.urls.add(saveUrl);
        state.download.href = saveUrl;
        state.download.download = sourceEntry?.doc.filename || (zipTools?.documentName ? zipTools.documentName(rec, target, ext) : `Banka-cevabi-${target.no || 'evrak'}.${ext}`);
        state.download.hidden = false;
        state.title.textContent = label;
        if (ext === 'html') {
          const html = await htmlBelgesi(doc.blob);
          if (!valid()) return;
          state.content.replaceChildren(el('iframe', { srcdoc: html, title: label, sandbox: '', class: 'htmldoc', referrerpolicy: 'no-referrer' }));
        } else if (ext === 'pdf') {
          const url = URL.createObjectURL(new Blob([doc.blob], { type: 'application/pdf' })); state.urls.add(url);
          state.content.replaceChildren(el('iframe', { src: url, title: label }));
        } else if (ext === 'txt') {
          const text = await doc.blob.text();
          if (!valid()) return;
          state.content.replaceChildren(el('pre', { class: 'bank-reply-text' }, text));
        } else if (['jpg', 'png', 'gif', 'bmp'].includes(ext)) {
          const url = URL.createObjectURL(doc.blob); state.urls.add(url);
          state.content.replaceChildren(el('div', { class: 'imgdoc' }, el('img', { src: url, alt: label })));
        } else {
          const tur = okuyucuTuru(doc, ext), reader = tur === 'udf' ? udf : tur === 'tiff' ? tiff : null;
          if (reader) {
            const container = el('div', { class: 'docview', tabindex: '0', 'aria-label': 'Banka cevabı evrak içeriği' });
            state.content.replaceChildren(container);
            const model = tur === 'udf' ? await udf.oku(doc.blob, { signal: ac.signal }) : await tiff.ac(doc.blob, { signal: ac.signal });
            if (!valid()) return;
            const rendered = reader.ciz(model, { signal: ac.signal, kaydirma: container });
            if (!valid()) { rendered.birak(); return; }
            state.render = rendered;
            container.replaceChildren(rendered.kok);
            rendered.olcekle(Math.max(.25, Math.min(1, (container.clientWidth - 32) / rendered.dogalEn)));
          } else state.content.replaceChildren(el('div', { class: 'msg' }, `Bu özgün ${ext.toUpperCase()} evrak bu önizlemede gösterilemiyor. Dosyayı indirin veya aşağıdan varsa ilgili eki seçin.`));
        }
        if (valid() && ihbarCevabiMi((target.ana || target).tur)) await bankViewRemember(target.ana || target);
      } catch (error) {
        if (valid()) state.content.replaceChildren(el('div', { class: 'msg dp-err', role: 'status' }, error?.name === 'AbortError' ? 'Cevap açma durduruldu.' : 'Cevap evrakı açılamadı. UYAP oturumunu kontrol edip Cevabı aç’a yeniden basın.'));
      } finally {
        if (valid()) { state.select.disabled = false; state.sourceSelect.disabled = false; }
      }
    }
    async function bankaAc(x) {
      if (closed || bankBusy()) return;
      bankReplyClose(false);
      const previous = shadowRoot.activeElement || document.activeElement;
      const closeReply = el('button', { type: 'button', 'data-bank-preview': 'close', title: 'Cevap önizlemesini kapat (Esc)' }, 'Kapat');
      const title = el('b', { 'data-bank-preview': 'title' }, `${x.tur} · ${tarihYaz(x.onay)}`);
      const download = el('a', { class: 'chip', hidden: true, 'data-bank-preview': 'download' }, 'Özgün evrakı indir');
      const content = el('div', { class: 'bank-reply-content', 'data-bank-preview': 'content' });
      const related = [x, ...tum.filter(item => item.ana && item.ana.k === x.k && item.ana.dosya === x.dosya)];
      const select = el('select', { 'data-bank-preview': 'document', 'aria-label': 'Cevap evrakı veya eki' }, related.map((item, i) => el('option', { value: String(i) }, `${i ? 'Ek: ' : ''}${item.tur}`)));
      select.hidden = related.length < 2;
      const sourceSelect = el('select', { 'data-bank-preview': 'source', 'aria-label': 'Paket içindeki özgün belge', hidden: true });
      const dialog = el('dialog', { class: 'bank-reply-preview', 'aria-label': `${ihbarCevabiMi(x.tur) ? 'Banka cevabı' : 'Talep evrakı'} önizlemesi` },
        el('div', { class: 'bar' }, title, closeReply),
        el('div', { class: 'bank-reply-toolbar' }, select, sourceSelect, download), content);
      const state = bankReplyPopupState = { dialog, title, download, content, select, sourceSelect, sourceDocs: [], target: x, previous, previousKey: previous?.getAttribute?.('data-bank-reply') || previous?.getAttribute?.('data-bank-request'), ac: new AbortController(), readAc: null, urls: new Set(), render: null };
      bankReplyPopup = dialog;
      closeReply.addEventListener('click', () => bankReplyClose());
      dialog.addEventListener('cancel', event => { event.preventDefault(); bankReplyClose(); });
      dialog.addEventListener('click', event => { if (event.target === dialog) bankReplyClose(); });
      select.addEventListener('change', () => { const target = related[Number(select.value)]; if (target && !select.disabled) return bankReplyRender(state, target); });
      sourceSelect.addEventListener('change', () => { const entry = state.sourceDocs[Number(sourceSelect.value)]; if (entry && !sourceSelect.disabled) return bankReplyRender(state, state.target, entry); });
      viewer.append(dialog);
      dialog.showModal(); closeReply.focus();
      await bankReplyRender(state, x);
    }
    
