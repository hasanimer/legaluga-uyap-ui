  const pad = n => String(n).padStart(2, '0');
  const visible = e => !!e && e.isConnected && e.getClientRects().length > 0 && getComputedStyle(e).visibility !== 'hidden';

  // name, hata raporunda türün (Error yerine Fatal vb.) görünmesi için atanır.
  class Fatal extends Error { constructor(...a) { super(...a); this.name = 'Fatal'; } }
  class Stopped extends Error { constructor(...a) { super(...a); this.name = 'Stopped'; } }
  class Superseded extends Error { constructor(...a) { super(...a); this.name = 'Superseded'; } }
  class Blocked extends Error { constructor(...a) { super(...a); this.name = 'Blocked'; } }   // UYAP güvenlik doğrulaması istiyor: beklemeler (soft) bunu yutmaz
  const CAPTCHA_MSG = 'UYAP güvenlik doğrulaması istiyor. UYAP’ta doğrulamayı tamamlayıp tekrar deneyin.';

  // waitFor yalnız dosya açma akışında kullanılır: yeni bir açma isteği gelince süren akış bir sonraki
  // yoklamada Superseded ile çıkar. Bekleme hataları yalnız soft() ile yutulur; kesilme hiçbir zaman yutulmaz.
  let openRun = null;
  const guardOpen = () => { if (openRun && openRun.cancelled) throw new Superseded('Dosya açma yeni bir istekle kesildi.'); };
  const soft = p => p.catch(e => { if (e instanceof Superseded || e instanceof Blocked) throw e; return null; });

  async function waitFor(fn, ms = 10000, msg) {
    const end = Date.now() + ms;
    for (;;) {
      guardOpen();
      const v = fn();
      if (v) return v;
      if (Date.now() > end) throw new Error(msg || 'UYAP ekranı zamanında yanıt vermedi.');
      await sleep(120);
    }
  }

  // ---------------------------------------------------------------- UYAP istekleri

  let sessionRequestHooks = null;
  // Eklentinin kendi dosya listesi sorgusunun zamanı (güncelleme, numarayla arama). "Doğrulama hatası" günlüğünde yazılır.
  let eklentiSorguAt = 0;

  // Aynı UYAP kökenindeki, aynı normal Chrome profilinin eklenti sekmeleri tek ağ kuyruğunu paylaşır. Kilit, yanıt gövdesi
  // okunana kadar tutulur; başarılı toplu isteklerin başlangıçları arasında en az 1,2 saniye vardır.
  // Aktarım süresi bu aralığa dahildir; hata veya iptalden sonra 1,2 saniye beklenir. Diğer istekler mevcut
  // 150 ms taban aralığını kullanır. Arka plan sekmesi
  // beklemeyi kaldırmaz. Depolanan kayıt yalnız teknik zamanları taşır, dosya/evrak bilgisi içermez.
  // Koruma kalıcıdır: 403, 429, 503, Retry-After, PRTL_GNL_1-1, insan etkinliği metni ve doğrulama HTML’i
  // otomatik kuyruğu durdurur. Süre dolunca kendiliğinden açılmaz. Girişe dönüş (401, PRTL_GNL_100026) ayrıdır.
  // Avukatın UYAP sayfasındaki kendi tıklamaları bu kapıdan geçmez.
  const UYAP_REQUEST_INTERVAL = 1200;
  const UYAP_REQUEST_LOCK = 'legaluga-uyap-request-v1', UYAP_REQUEST_STATE = 'uhdUyapRequestGate';
  const UYAP_KORUMA = 'uhdUyapKoruma';
  const UYAP_KORUMA_MESAJ = 'UYAP koruması nedeniyle otomatik işlemler duraklatıldı. Kendiliğinden devam etmez. UYAP ekranını kontrol edin, sonra “Otomatik işlemleri yeniden aç”a basın (Ayarlar → UYAP bağlantısı ve koruma).';
  const uyapBulkSignals = new WeakSet();
  function uyapBulk(signal) { if (signal) uyapBulkSignals.add(signal); return signal; }
  const uyapProtectionHtml = text => /^\s*(?:<!doctype\s+html|<(?:html|head|body|form|script|iframe|div)\b)/i.test(text) &&
    /recaptcha|hcaptcha|challenge-platform|cf-chl-|captcha|verify\s+(?:that\s+)?you\s+are\s+(?:a\s+)?human|g[üu]venlik\s+do[ğg]rulama|security\s+(?:check|verification)|too\s+many\s+requests|access\s+denied/i.test(text);
  function uyapWait(ms, signal) {
    if (signal?.aborted) return Promise.reject(new DOMException('Durduruldu.', 'AbortError'));
    return new Promise((resolve, reject) => {
      const done = () => { clearTimeout(timer); signal?.removeEventListener('abort', stop); resolve(); };
      const stop = () => { clearTimeout(timer); signal?.removeEventListener('abort', stop); reject(new DOMException('Durduruldu.', 'AbortError')); };
      const timer = setTimeout(done, ms);
      signal?.addEventListener('abort', stop, { once: true });
    });
  }
  function uyapRetryAt(value, now = Date.now()) {
    if (typeof value !== 'string' || !value.trim()) return null;
    const text = value.trim();
    const at = /^\d+$/.test(text) ? now + Number(text) * 1000
      : /^(?:[A-Za-z]{3},|[A-Za-z]+,|[A-Za-z]{3}\s+[A-Za-z]{3}\s)/.test(text) ? Date.parse(text) : NaN;
    return Number.isFinite(at) ? Math.max(now, at) : null;
  }
  function uyapKorumaHatasi() {
    return Object.assign(new Blocked(UYAP_KORUMA_MESAJ), { uyap: true, durdu: true, kind: 'koruma' });
  }
  async function uyapOtomasyonDurdu() {
    try {
      const saved = (await chrome.storage.local.get(UYAP_KORUMA))[UYAP_KORUMA];
      const durdu = saved?.durdu === true;
      globalThis.UHDUyapKorumaDurdu = durdu;
      return durdu;
    } catch { return globalThis.UHDUyapKorumaDurdu === true; }
  }
  let uyapKorumaYaziyor = false;
  async function uyapKorumaYaz() {
    if (uyapKorumaYaziyor || globalThis.UHDUyapKorumaDurdu === true) return;
    globalThis.UHDUyapKorumaDurdu = true;
    uyapKorumaYaziyor = true;
    try {
      // Koruma yalnız bu kayıtta tutulur; okumadan tek yazım arada yazılan başka bir kaydı ezmez.
      await chrome.storage.local.set({ [UYAP_KORUMA]: { durdu: true, neden: UYAP_KORUMA_MESAJ } });
      globalThis.UHDUyapKapiIstemci?.koru(UYAP_KORUMA_MESAJ);
    } catch { /* bellek bayrağı bu sekmeyi yine durdurur */ }
    finally { uyapKorumaYaziyor = false; }
  }
  // Kilidi yalnız service worker açar (uhd-uyap-koruma-birak). Sekme yankıda yalnız bellek bayrağını izler; depolamaya ve kapıya
  // yazmaz ki geç gelen bir açılış yankısı arada yazılan yeni korumayı silmesin.
  if (chrome.storage?.onChanged?.addListener) {
    chrome.storage.onChanged.addListener((changes, area) => {
      if (area !== 'local' || !changes[UYAP_KORUMA]) return;
      globalThis.UHDUyapKorumaDurdu = changes[UYAP_KORUMA].newValue?.durdu === true;
    });
  }
  function uyapResponseGate(res) {
    const retryAt = uyapRetryAt(res.headers?.get('Retry-After'));
    if (![403, 429, 503].includes(res.status) && (res.ok || retryAt === null)) return;
    const message = res.status === 429 ? 'UYAP istek sıklığını sınırlandırdı.'
      : res.status === 403 ? 'UYAP erişimi sınırlandırdı; oturumu ve güvenlik doğrulamasını kontrol edin.'
        : 'UYAP hizmeti geçici olarak kullanılamıyor.';
    throw Object.assign(new Blocked(`${message} ${UYAP_KORUMA_MESAJ}`),
      { status: res.status, uyap: true, durdu: true, kind: 'koruma' });
  }
  async function uyapRequestKilit(signal, request) {
    if (signal?.aborted) throw new DOMException('Durduruldu.', 'AbortError');
    // Kilitsiz çalışıp sekmeler arasında eşzamanlı istek üretmek yerine güvenli biçimde dur.
    if (!navigator.locks?.request) throw new Blocked('UYAP istek kuyruğu kullanılamıyor. Chrome’u güncelleyip sayfayı yenileyin.');
    return navigator.locks.request(UYAP_REQUEST_LOCK, signal ? { signal } : {}, async () => {
      if (signal?.aborted) throw new DOMException('Durduruldu.', 'AbortError');
      // Koruma yalnız UYAP_KORUMA’da tutulur; kapı kaydı yalnız istek zamanını taşır, istek sonunda yazılırken arada yazılan
      // korumayı ezemez. Koruma kaydı hiç yazılmamışsa eski sürümün kapı kaydındaki durdu da sayılır.
      const saved = await chrome.storage.local.get([UYAP_REQUEST_STATE, UYAP_KORUMA]);
      const gate = saved[UYAP_REQUEST_STATE], koruma = saved[UYAP_KORUMA];
      const state = {
        nextAt: Number.isFinite(gate?.nextAt) ? gate.nextAt : 0,
        durdu: koruma ? koruma.durdu === true : gate?.durdu === true
      };
      if (state.durdu || globalThis.UHDUyapKorumaDurdu === true) throw uyapKorumaHatasi();
      if (state.nextAt > Date.now()) await uyapWait(state.nextAt - Date.now(), signal);
      if (signal?.aborted) throw new DOMException('Durduruldu.', 'AbortError');
      const startedAt = Date.now();
      let completed = false;
      try {
        const result = await request();
        completed = !signal?.aborted;
        return result;
      }
      catch (err) {
        if (err instanceof Blocked) state.durdu = true;
        throw err;
      } finally {
        const finishedAt = Date.now(), bulk = signal && uyapBulkSignals.has(signal);
        state.nextAt = bulk && completed ? Math.max(finishedAt, startedAt + UYAP_REQUEST_INTERVAL)
          : finishedAt + (bulk ? UYAP_REQUEST_INTERVAL : DELAY);
        const kayit = { [UYAP_REQUEST_STATE]: { nextAt: state.nextAt } };
        if (state.durdu) {
          kayit[UYAP_KORUMA] = { durdu: true, neden: UYAP_KORUMA_MESAJ };
          globalThis.UHDUyapKorumaDurdu = true;
        }
        await chrome.storage.local.set(kayit);
        if (state.durdu) { try { globalThis.UHDUyapKapiIstemci?.koru(UYAP_KORUMA_MESAJ); } catch { /* depolama diğer sekmeyi durdurur */ } }
      }
    });
  }
  // Worker kapısının koruma reddi porttan düz Error (name 'Blocked', durdu) olarak gelir. Tarama, beklemeler ve paneller
  // korumayı Blocked örneğiyle tanıdığı için ret bu tek sınırda Blocked’a çevrilir; sekmede doğan Blocked ve iptal olduğu gibi geçer.
  async function uyapRequest(signal, request) {
    const istemci = globalThis.UHDUyapKapiIstemci;
    const icinde = !!(signal && typeof signal === 'object' && globalThis.UHDUyapKapiIcinde?.has(signal));
    if (istemci && !icinde) {
      if (globalThis.UHDUyapKorumaDurdu === true) throw uyapKorumaHatasi();
      return istemci.toplu(signal, () => uyapRequestKilit(signal, request)).catch(err => {
        if (!(err instanceof Blocked) && (err?.durdu === true || err?.name === 'Blocked')) throw Object.assign(uyapKorumaHatasi(), { cause: err });
        throw err;
      });
    }
    return uyapRequestKilit(signal, request);
  }
