        b.addEventListener('click', () => grupSec(g));
        return b;
      }));
    }
    // Görünüm sırası (düz listede ve klasör içinde) ayrı tutulur: Son 20, ZIP, paket ve önizleme gezintisi aynı evrak kapsamını kullanır.
    // Ekler ana evrakının ardında kalır; aramada yalnız ekleri kalan ana evrakın ekleri de birlikte taşınır.
    function gorunumSirasi(rows) {
      if (!tarihArtan) return rows;
      const bloklar = [];
      for (const x of rows) {
        const son = bloklar[bloklar.length - 1], bas = son && (son[0].ana || son[0]);
        if (x.ana && bas && ayni(bas, x.ana)) son.push(x); else bloklar.push([x]);
      }
      return bloklar.reverse().flat();
    }
    // Ana dosya, talimat ve diğer esaslar UYAP’ın dosya grubu altında; her dosyanın türleri kendi içinde sıralanır.
    function evrakKlasorleri(rows) {
      const dosyalar = new Map();
      for (const x of rows) {
        const dosya = x.ana?.dosya || x.dosya || kaynakGrubu() || rec.dosyaNo || 'Dosya';
        if (!dosyalar.has(dosya)) dosyalar.set(dosya, []);
        dosyalar.get(dosya).push(x);
      }
      const main = g => !g || g === rec.dosyaNo || g.startsWith(rec.dosyaNo + '(');
      return [...dosyalar].sort(([a], [b]) => Number(main(b)) - Number(main(a)) || a.localeCompare(b, 'tr-TR', { numeric: true }))
        .map(([dosya, items]) => ({ key: JSON.stringify(['dosya', dosya]), title: evrakDosyaAdi(dosya), items,
          ...evrakSayim(items), categories: evrakKategorileri(items).map(kat => ({ ...kat, key: JSON.stringify(['tur', dosya, kat.key]) })) }));
    }
    function kategoriYoluAc(key) {
      const kat = kategoriDom.get(key);
      if (!kat) return;
      if (kat.parent) kategoriYoluAc(kat.parent);
      kategoriAc(key, true);
    }
    function kategoriGezinme() {
      const gez = key => {
        const kat = kategoriDom.get(key);
        return !kat ? [] : [kat.head, ...(kat.box.open ? kat.children.length ? kat.children.flatMap(gez) : kat.rows.filter(row => !row.hidden) : [])];
      };
      return kategoriKokleri.flatMap(gez);
    }
    function kategoriAc(key, on) {
      if (aramaImza) { if (on) aramadaKapali.delete(key); else aramadaKapali.add(key); }
      else { if (on) acikKategoriler.add(key); else acikKategoriler.delete(key); }
