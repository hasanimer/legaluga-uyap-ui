    }
    // Ekler aramasızken kapalı, aramada açık gelir. Satırlar DOM'da kalır, yalnız gizlenir: liste yeniden çizilmez, seçim ve önizleme
    // değişmez, UYAP isteği yapılmaz. kalici: aramada açılan ekler arama temizlenince de açık kalır (seçilen ek görünür kalsın).
    const ekAcik = key => aramaImza ? !aramadaKapaliEk.has(key) : acikEkler.has(key);
