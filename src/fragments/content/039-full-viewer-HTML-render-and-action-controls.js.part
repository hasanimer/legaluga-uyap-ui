    const paketSiraGor = el('button', { type: 'button', class: 'chip' }, 'Sırayı düzenle');
    const paketGorunen = el('button', { type: 'button', class: 'chip' }, 'Listelenenleri seç');
    const paketTemizle = el('button', { type: 'button', class: 'chip' }, 'Seçimi temizle');
