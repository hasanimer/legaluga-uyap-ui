      if (bulkTools && !bulkChoice) zipParts.checked = count > bulkTools.PART_ENTRIES;
      const needsFullList = !!(kaynak?.list.morePages || kaynak?.list.scopeUnknown) && !['son20', 'gorunen'].includes(zipKapsam);
      const busy = !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!listeBekliyor;
      const savedPlan = bulkState ? bulkState.saved < bulkState.total : !!bulkJob && bulkJob.cursor < bulkJob.targets.length;
      zipIndir.disabled = busy || !!bulkRead || !zipTools || !!kaynak?.list.kilit || (!!kaynak && !count && !needsFullList) || (!!zipParts.checked && (!!bulkJob || !!bulkState));
      const action = zipParts.checked ? 'Parçalı indir' : 'ZIP olarak indir';
