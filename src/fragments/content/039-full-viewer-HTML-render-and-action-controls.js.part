    }

    let kaynak = o.kaynak || null;   // { dosyaId, list }
    let listeHazirlandi = false, listeBekliyor = null, listeHata = '';   // evrak listesi bütün sekmeler arasında paylaşılır
    let tum = [], yeni = null, grup = 'son20', gorunen = [], sira = -1, simdiki = null, simdikiOge = null, gezEpoch = 0, gecikme = null, gezAc = null;
