      if (kategorili) d.ana?.setAttribute('aria-expanded', String(on));
    }
    // Kapalı ekli satırı etkinleştirmek evrakı seçer ve eklerini açar; açık satır yalnız eklerini kapatır.
    // Yön tuşları ekAc ile yalnız liste durumunu değiştirir, paket kutusu kendi seçim eylemini sürdürür.
    function satirEtkinlestir(i) {
      const x = gorunen[i];
      if (!x) return;
      const anaK = !x.ana && ekDom.get(paketAnahtar(x))?.ana ? paketAnahtar(x) : null;
      const acik = !!anaK && ekAcik(anaK);
      if (anaK) ekAc(anaK, !acik);
      if (acik) { evrakOdak = { row: anaK }; odakSync(); }
      else sec(i, true);
      ogeler.focus({ preventScroll: true });
    }
    function odakSync(visible = false) {
      let node = null;
      if (evrakOdak?.kat && kategorili) node = kategoriDom.get(evrakOdak.kat)?.head;
      else if (evrakOdak?.row) {
        const i = gorunen.findIndex(x => paketAnahtar(x) === evrakOdak.row);
        node = ogeler.querySelector(`[data-i="${i}"]`);
      }
      if (!node && sira >= 0) node = ogeler.querySelector(`[data-i="${sira}"]`);
      // Kapalı ekteki odak ana evraka düşer; seçim (.on), önizleme ve konum değişmez.
      if (node?.hidden && node.classList.contains('ek-oge')) { const y = gorunen[Number(node.dataset.i)]; node = (y?.ana && ekDom.get(paketAnahtar(y.ana))?.ana) || null; }
      if (node && kategorili && node.dataset.kategori) {
        let kat = kategoriDom.get(node.dataset.kategori);
        while (kat) { if (!kat.box.open) node = kat.head; kat = kategoriDom.get(kat.parent); }
      }
      if (!node) node = kategorili ? kategoriDom.get(kategoriKokleri[0])?.head : ogeler.querySelector('.ek-oge');
      for (const old of ogeler.querySelectorAll('.odak')) old.classList.toggle('odak', false);
      if (node) {
        evrakOdak = node.classList.contains('ek-oge') ? { row: paketAnahtar(gorunen[Number(node.dataset.i)]) } : { kat: node.dataset.kategori };
