      paketDurum);
    const evrakPanel = el('div', { class: 'ek-evrak' }, el('div', { class: 'ek-liste' }, gruplar, listeArac, paketAc, paketBar, listeDurum, ogeler), onizleme);

    let kaynak = o.kaynak || null;   // { dosyaId, list }
    let ilkBekliyor = false, listeBekliyor = null, listeHata = '';   // liste isteği ve ilk evrak sekmeler arasında paylaşılır
    let tum = [], yeni = null, grup = 'tumu', gorunen = [], sira = -1, simdiki = null, simdikiOge = null, gezEpoch = 0, gecikme = null, gezAc = null;
    let kategorili = true, tarihArtan = false, evrakOdak = null, aramaImza = '';
    const acikKategoriler = new Set(), aramadaKapali = new Set(), kategoriDom = new Map();
    // Ana evrakın ekleri kapalı başlar; Yeni listesindeki ana evrakın ekleri açık (yeniAcilanEk: ekranda bir kez açılanlar). Açık olanlar
    // (paketAnahtar) yalnız bu ekranda tutulur, hiçbir yere yazılmaz; aramada kapatılanlar arama değişince unutulur.
    // ekDom: ana evrak anahtarı -> { ana satır, ek sayısı yazısı, ek satırları }.
    const acikEkler = new Set(), aramadaKapaliEk = new Set(), ekDom = new Map(), yeniAcilanEk = new Set();
    let bekleyenAna = null;   // ana evrakı listede yokken seçilen ekin ana evrakı: listede görününce bir kez açılır
    let tebligatRead = null, tebligatList = null, tebligatCache = null;
    let zipRun = null, zipState = null, zipUrl = null;
    let bulkJob = null, bulkRead = null, bulkLoaded = false, bulkChoice = false, bulkIssue = '';
    let bulkState = null, bulkOff = null, bulkFinished = '';
    let paketSession = null, paketRun = null;
    let paketMod = false, paketSecili = [], paketSira = 'eski', paketSonucUrl = null, paketOzgunAc = null;
    const PAKET_MAX = 100;
    const paketAnahtar = x => x.k + '\n' + x.dosya;
    // Pakete alınabilen: anahtarı olan evrak; ek ise UYAP'ın verdiği kendi kimliğiyle.
    const paketAlinir = x => { if (!x || !x.k) return false; if (!x.ana) return true; const id = x.ana.e?.ekEvrakListesi?.[x.ekIndis]?.evrakId; return id != null && id !== ''; };
    const yakinlik = { mod: 'sigdir', oran: 1 };
    const onayTs = x => trDateTs(x.onay);
    // Ekranda tarih saniyesiz; saat yoksa (00:00) yalnız gün.
    const tarihYaz = t => fmtTrDate(t).replace(/(\d{2}:\d{2}):\d{2}$/, '$1').replace(/ 00:00$/, '');
    const oge = (k, dosya, e) => {
      const [no, onay, ...tur] = k.split('|');
      return { k, dosya: dosya || '', e, tur: (e && e.tur) || tur.join('|') || 'Evrak', onay: (e && e.onaylandigiTarih) || onay, no: (e && e.birimEvrakNo) || no,
        gonderen: (e && (e.gonderenYerKisiAdi || e.gonderenYerKisi)) || '' };
    };
    // Tümü ve Yeni en yenisi önce (güncellemeler yeni evrakı bulunduğu sırayla öne ekler). Yeni: evrakın açıldığı karttaki yeni
    // evraklar; listede bulunamayanlar da kalır, seçilince liste bir kez yenilenip yeniden aranır.
    function listeKur() {
      if (tebligatRead?.explicit && (tebligatRead.source !== kaynak || tebligatRead.list !== kaynak.list)) tebligatRead.ac.abort();
      if (tebligatCache && (tebligatCache.source !== kaynak || tebligatCache.list !== kaynak.list)) tebligatCache = null;
      yeni = null;
      // Ekler ana evrakın hemen ardından gelir (1.19.4); yalnız ek listesinde olan ekin anahtarı ana evrakınkinden türer.
      tum = ekleriYerlestir(kaynak.list.map((e, i) => ({ ...oge(evrakKey(e) || '', e.dosyaGrubu, e), i })).filter(x => x.k)
        .sort((a, b) => onayTs(b) - onayTs(a) || a.i - b.i), onayTs)
        .map(x => x.ekIndis == null ? x : { k: `${x.ana.k}|ek|${x.ekIndis}`, dosya: x.ana.dosya, e: null, tur: x.ekTuru, onay: x.ana.onay, no: x.ana.no, gonderen: '', ana: x.ana, ekIndis: x.ekIndis,
          ekId: x.ana.e?.ekEvrakListesi?.[x.ekIndis]?.evrakId });
      if (!kaynak.list.kilit && o.baglam && o.baglam.ad === 'yeni' && Array.isArray(o.baglam.liste) && o.baglam.liste.length) {
        const bul = (k, d) => tum.find(x => x.k === k && (!d || !x.dosya || x.dosya === d));
        const gorulen = new Set();
        yeni = o.baglam.liste.filter(x => x && typeof x.k === 'string' && x.k).slice(0, GEZINME_MAX)
          .map(x => bul(x.k, x.dosya) || oge(x.k.slice(0, 300), typeof x.dosya === 'string' ? x.dosya.slice(0, 300) : '', null))
          .filter(x => { const a = x.k + '\n' + x.dosya; if (gorulen.has(a)) return false; gorulen.add(a); return true; })
          .map((x, i) => ({ x, i })).sort((a, b) => onayTs(b.x) - onayTs(a.x) || a.i - b.i).map(({ x }) => x);
        // Yeni evrakın ekleri de onun ardından gelir: sırayla okurken ekler de açılır, "görüldü say" en son ekten sonra çıkar.
        const alindi = new Set();
        yeni = yeni.flatMap(a => [a, ...tum.filter(x => x.ana && x.ana.k === a.k && (!a.dosya || !x.dosya || x.dosya === a.dosya))])
          .filter(x => { const a = x.k + '\n' + x.dosya; if (alindi.has(a)) return false; alindi.add(a); return true; });
        // Yeni evrakın ekleri açık gelir: son ek görünür, End ve son satıra tıklama ona ulaşır. Her ana evrakın ekleri ekranda bir kez
        // açılır; kullanıcının sonradan kapattığı ekler liste yenilense de kapalı kalır.
        for (const a of yeni.filter(x => x.ana).map(x => paketAnahtar(x.ana))) if (!yeniAcilanEk.has(a)) { yeniAcilanEk.add(a); acikEkler.add(a); }
      }
    }
    // Son 20: en yeni 20 evrak ve ekleri.
    const son20 = () => { let n = 0; return tum.filter(x => (x.ana ? n <= 20 : ++n <= 20)); };
    const grupListesi = g => (g === 'yeni' ? yeni || [] : g === 'son20' ? son20() : tum);
    const aranan = x => norm([x.tur, x.ana || x.yetimEk ? 'ek' : '', x.ana ? x.ana.tur : '', x.dosya, fmtTrDate(x.onay), x.no, x.gonderen].filter(Boolean).join(' '));
    function suz() {
      const t = norm(ara.value).split(/\s+/).filter(Boolean);
      const imza = t.join(' ');
      if (imza !== aramaImza) { aramaImza = imza; aramadaKapali.clear(); aramadaKapaliEk.clear(); }
      const liste = grupListesi(grup);
      gorunen = t.length ? liste.filter(x => { const m = aranan(x); return t.every(w => m.includes(w)); }) : liste;
    }
    const ayni = (a, b) => !!a && !!b && a.k === b.k && (!a.dosya || !b.dosya || a.dosya === b.dosya);
    function gruplariCiz() {
      const secenek = [yeni && ['yeni', `Yeni (${fmtNum(yeni.length)})`], ['son20', 'Son 20'], ['tumu', `Tümü (${fmtNum(tum.length)})`]].filter(Boolean);
      gruplar.replaceChildren(...secenek.map(([g, ad]) => {
        const b = el('button', { type: 'button', class: 'chip' + (g === grup ? ' on' : ''), 'aria-pressed': String(g === grup), 'data-grup': g }, ad);
        b.addEventListener('click', () => grupSec(g));
        return b;
      }));
    }
    // Görünüm sırası (düz listede ve klasör içinde) ayrı tutulur: Son 20, ZIP, paket ve önizleme gezintisi aynı evrak kapsamını kullanır.
    // Ekler ana evrakının ardında kalır; aramada yalnız ekleri kalan ana evrakın ekleri de birlikte taşınır.
    function gorunumSirasi(rows) {
      if (!tarihArtan) return rows;
      const bloklar = [];
      for (const x of rows) {
        const son = bloklar[bloklar.length - 1], bas = son && (son[0].ana || son[0]);
        if (x.ana && bas && ayni(bas, x.ana)) son.push(x); else bloklar.push([x]);
      }
      return bloklar.reverse().flat();
    }
    function kategoriAc(key, on) {
      if (aramaImza) { if (on) aramadaKapali.delete(key); else aramadaKapali.add(key); }
      else { if (on) acikKategoriler.add(key); else acikKategoriler.delete(key); }
      const kat = kategoriDom.get(key);
      if (kat) { kat.box.open = on; kat.head.setAttribute('aria-expanded', String(on)); }
    }
