        const on = i === sira;
        // Ek: girintili, "Ek" rozetiyle ve hangi evrakın eki olduğu yazılarak. Ekli ana evrakın satırı (anaK) ekleri açıp kapatır;
        // başlıktaki küçük ok açık/kapalı durumu gösterir. Kapalı satır tıklanınca evrak da görüntülenir.
        const anaK = !x.ana && ekSay.has(paketAnahtar(x)) ? paketAnahtar(x) : null, ustK = x.ana && ekSay.has(paketAnahtar(x.ana)) ? paketAnahtar(x.ana) : null;
        const acik = !!anaK && ekAcik(anaK), n = anaK ? ekSay.get(anaK) : 0;
