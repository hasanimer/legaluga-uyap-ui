          const head = el('summary', { class: 'ek-kategori-baslik', id: `${kimlik}-c${index}`, role: 'treeitem', 'aria-level': String(level), 'aria-expanded': 'false', tabindex: '-1', 'data-kategori': kat.key,
            'aria-owns': `${kimlik}-cg${index}`,
            'aria-label': `${kat.title}, ${fmtNum(kat.evrakSayisi)} evrak, ${fmtNum(kat.ekSayisi)} ek`, title: `${kat.title} (${fmtNum(kat.evrakSayisi)} evrak, ${fmtNum(kat.ekSayisi)} ek)` },
            el('span', { class: 'ek-kategori-ok', 'aria-hidden': 'true' }, '▸'), el('span', { class: 'ek-klasor', 'aria-hidden': 'true' }),
