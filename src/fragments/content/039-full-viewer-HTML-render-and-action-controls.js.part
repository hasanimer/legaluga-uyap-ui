    function ekAc(key, on, kalici = false) {
      if (aramaImza) { if (on) aramadaKapaliEk.delete(key); else aramadaKapaliEk.add(key); }
      else if (!on) acikEkler.delete(key);
      if (on && (kalici || !aramaImza)) acikEkler.add(key);
