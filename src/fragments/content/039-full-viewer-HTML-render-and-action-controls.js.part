    const ekAcik = key => aramaImza ? !aramadaKapaliEk.has(key) : acikEkler.has(key);
    // Düz listede (listbox) option aria-expanded taşıyamaz: ek sayısı, açık/kapalı durum ve tuşu option açıklamasında okunur.
