      } else { evrakOdak = null; bekleyenAna = null; }
      odakSync(visible);
    }
    const zipSelection = () => ({ mode: zipTypeMode.value || 'all', keys: [...zipSelectedTypes], includeAttachments: zipEkler.checked });
    function zipCandidates(kapsam = zipKapsam) {
      const targets = new Map();
      for (const x of kapsam === 'gorunen' ? gorunen : grupListesi(kapsam)) {
        const key = x.k + '\n' + x.dosya;
        if (!targets.has(key)) targets.set(key, x);
      }
      return [...targets.values()];
    }
    // Aynı belge bir kez iner (1.19.43): listede ayrıca gelen evrak, başka evrakların ek listesinde de geçebilir (UYAP gibi kendi
    // satırında ve ek satırında görünür). Tür seçiminden SONRA, kimliği seçilmiş bir ana satırla aynı olan ek satırı atılır; ana
    // satır seçilmediyse aynı ekin yalnız ilk kopyası kalır. Kimlikler aynı listeden geldiği için dosya grubu içinde karşılaştırılır.
    function tekBelge(rows) {
      const kimlik = v => v == null || v === '' ? null : String(v);
      const anaKimlikleri = new Set(rows.filter(x => !x.ana && kimlik(x.e?.evrakId) != null).map(x => x.dosya + '\n' + kimlik(x.e.evrakId)));
      const gorulen = new Set();
      return rows.filter(x => {
        if (!x.ana || kimlik(x.ekId) == null) return true;
        const a = x.dosya + '\n' + kimlik(x.ekId);
        if (anaKimlikleri.has(a) || gorulen.has(a)) return false;
        gorulen.add(a);
        return true;
      });
    }
    // Duruşma paketi "Listelenenleri seç" de aynı belgeyi bir kez alır (tekBelge kuralı): pakette olan ya da listelenen ana satırla
    // aynı kimlikteki ek kopyası, aynı ekin sonraki kopyaları ve ek kopyası pakette olan belgenin kendi satırı alınmaz. Elle
    // işaretleme serbesttir.
    function paketGorunenYeni() {
      const secili = new Set(paketSecili), pakette = tum.filter(x => secili.has(paketAnahtar(x)));
      const belge = x => { const v = x.ana ? x.ekId : x.e?.evrakId; return v == null || v === '' ? null : x.dosya + '\n' + String(v); };
      const alinmis = new Set(pakette.map(belge).filter(Boolean));
      return tekBelge([...pakette, ...gorunen.filter(x => paketAlinir(x) && !secili.has(paketAnahtar(x)))])
        .filter(x => !secili.has(paketAnahtar(x)) && !alinmis.has(belge(x)));
    }
    function zipTargets(kapsam = zipKapsam, selection = zipSelection()) {
      const rows = zipCandidates(kapsam);
      return tekBelge(zipTools?.selectRows ? zipTools.selectRows(rows, selection) : rows.filter(x => selection.includeAttachments || !(x.ana || x.yetimEk)));
    }
    function zipTypesCiz() {
      const partial = !!(kaynak?.list.morePages || kaynak?.list.scopeUnknown) && !['son20', 'gorunen'].includes(zipKapsam);
      const rows = zipCandidates(), groups = zipTools?.typeGroups?.(rows) || [];
      const query = norm(zipTypeSearch.value), shown = groups.filter(group => norm(group.title).includes(query));
      const signature = JSON.stringify([shown, partial]);
      if (zipTypeList.dataset.imza !== signature) {
        const scroll = zipTypeList.scrollTop;
        zipTypeList.dataset.imza = signature;
        zipTypeList.replaceChildren(...shown.map(group => {
          const input = el('input', { type: 'checkbox', value: group.key, 'data-zip-type': group.key });
          input.addEventListener('change', () => {
            if (zipRun) return;
            if (input.checked) zipSelectedTypes.add(group.key); else zipSelectedTypes.delete(group.key);
            zipSync();
          });
          return el('label', { class: 'ti-secenek' }, input, el('span', null, group.title,
            el('small', null, `${fmtNum(group.documents)}${partial ? '+' : ''} evrak + ${fmtNum(group.attachments)}${partial ? '+' : ''} ek`)));
        }));
        zipTypeList.scrollTop = scroll;
      }
      for (const input of zipTypeList.querySelectorAll('[type="checkbox"]')) { input.checked = zipSelectedTypes.has(input.value); input.disabled = !!zipRun; }
      const all = zipTypeMode.value === 'all';
      zipTypeList.hidden = zipTypeActions.hidden = all;
      zipTypeMode.disabled = !!zipRun || !zipTools?.selectRows;
      zipTypeSearch.disabled = zipTypeAll.disabled = zipTypeClear.disabled = !!zipRun;
      zipTypeAll.textContent = query ? 'Aramadakileri seç' : 'Hepsini seç';
      zipTypeHint.textContent = all ? 'Seçilen kapsamdaki tüm evrak türleri alınır.' : zipTypeMode.value === 'include'
        ? 'İşaretlediğiniz ana evraklar ve ekleri alınır (Ekleri de indir açıksa). Bir ek türünü doğrudan da seçebilirsiniz.'
        : 'İşaretlediğiniz türler indirilmez. Ana evrakın türünü hariç tutmak bağlı eklerini de çıkarır; ekin kendi türü yalnız o eki çıkarır.';
      if (!all && !shown.length) zipTypeHint.textContent += query ? ' Aramaya uyan tür yok.' : ' Evrak türleri liste alınınca gösterilir.';
      if (partial) zipTypeHint.textContent += ' Liste kısmi; + sayıları artabilir. İndirme başlamadan önce tam liste üzerinden seçim uygulanır.';
      const selected = zipTargets(), documents = selected.filter(x => !(x.ana || x.yetimEk)).length, attachments = selected.length - documents, plus = partial ? '+' : '';
      zipSelectionCount.textContent = !kaynak ? 'İndirilecek sayı evrak listesi alınınca gösterilir.'
        : `İndirilecek: ${fmtNum(documents)}${plus} evrak + ${fmtNum(attachments)}${plus} ek = ${fmtNum(selected.length)}${plus} / ${fmtNum(rows.length)}${plus} toplam.`;
      if (zipState || bulkJob || bulkState) zipSelectionCount.textContent += ' Bu seçimler yeni indirme içindir; kalanları tekrar denemek ve devam etmek önceki hedef listesini kullanır.';
    }
    // Toplu İndir sekmesindeki kapsam seçenekleri; seçenekler değişmedikçe yeniden kurulmaz (oklarla gezinirken odak kalır).
    function zipKapsamCiz() {
      const secenek = [['tumu', kaynak ? `Tüm evraklar (${fmtNum(tum.length)}${kaynak.list.morePages ? '+' : ''})` : 'Tüm evraklar'], ['son20', 'Son 20 evrak'],
        yeni && yeni.length ? ['yeni', `Yeni evraklar (${fmtNum(yeni.length)})`] : null,
        kaynak && (ara.value.trim() || grup !== 'tumu') ? ['gorunen', `Evrak sekmesinde listelenenler (${fmtNum(gorunen.length)})`] : null].filter(Boolean);
      if (!secenek.some(([k]) => k === zipKapsam)) zipKapsam = 'tumu';
      const imza = JSON.stringify(secenek);
      if (zipKapsamlar.dataset.imza !== imza) {
        zipKapsamlar.dataset.imza = imza;
        zipKapsamlar.replaceChildren(...secenek.map(([k, ad]) => {
          const r = el('input', { type: 'radio', name: `${kimlik}-kapsam`, value: k });
          r.addEventListener('change', () => { if (r.checked) { zipKapsam = k; zipSync(); } });
          return el('label', { class: 'ti-secenek' }, r, el('span', null, ad));
        }));
      }
      for (const r of zipKapsamlar.querySelectorAll('[type="radio"]')) { r.checked = r.value === zipKapsam; r.disabled = !!zipRun; }
    }
    function zipSync() {
      if (closed) return;
      zipKapsamCiz();
      zipTypesCiz();
      const count = zipTargets().length;
      if (bulkTools && !bulkChoice) zipParts.checked = count > bulkTools.PART_ENTRIES;
      const needsFullList = !!(kaynak?.list.morePages || kaynak?.list.scopeUnknown) && !['son20', 'gorunen'].includes(zipKapsam);
      const busy = !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!listeBekliyor || !!belgePdfRun;
      const savedPlan = bulkState ? bulkState.saved < bulkState.total : !!bulkJob && bulkJob.cursor < bulkJob.targets.length;
      zipIndir.disabled = busy || !!bulkRead || !zipTools || !!kaynak?.list.kilit || (!!kaynak && !count && !needsFullList) || (!!zipParts.checked && (!!bulkJob || !!bulkState));
      const action = zipParts.checked ? 'Parçalı indir' : 'ZIP olarak indir';
      zipIndir.textContent = kaynak && !needsFullList && count ? `${action} (${fmtNum(count)} evrak)` : action;
      zipIndir.title = zipParts.checked && (bulkJob || bulkState) ? 'Yeni bir indirme için Yeni indirme planı seçin; kalan evraklar için devam edin.' : listeBekliyor ? 'Evrak listesi UYAP’tan alınıyor.' : kaynak?.list.kilit ? 'UYAP evrak listesi kilitli.' : bankaOkuma ? 'Banka cevapları okunurken ZIP indirilemez.' : paketSession ? 'Duruşma paketi hazırlanırken ZIP indirilemez.' : '';
      paketAraclari.hidden = !paketMod;
      paketBar.hidden = !paketMod;
      paketYaz();
      zipEkler.disabled = !!zipRun;
      zipParts.disabled = !!zipRun || !bulkTools;
      bulkCard.hidden = !bulkJob && !bulkState && !bulkIssue;
      if (bulkJob || bulkState) {
        const last = bulkState ? bulkState.lastPart : bulkJob.parts.at(-1);
        bulkStatus.textContent = `${fmtNum(bulkState?.saved ?? bulkJob.cursor)}/${fmtNum(bulkState?.total ?? bulkJob.targets.length)} evrak diske kaydedildi · ${fmtNum(bulkState?.partCount ?? bulkJob.parts.length)} ZIP parçası${last ? ` · Son kayıt: ${new Date(last.completedAt).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' })}` : ''}. ` +
          (bulkState?.persistentPending || bulkJob?.pendingDownload ? 'Chrome indirmesi henüz tamamlanmadı. Durumunu kontrol edebilirsiniz.' : savedPlan ? 'Devam etmek kaydedilmiş kapsamı kullanır; yukarıdaki seçimler bu planı değiştirmez.' : 'Bu indirme tamamlandı.') + (bulkIssue ? ` ${bulkIssue}` : '');
      } else bulkStatus.textContent = bulkIssue;
      bulkResume.hidden = !savedPlan;
      bulkResume.textContent = bulkState?.persistentPending || bulkJob?.pendingDownload ? 'İndirme durumunu kontrol et' : 'Kaldığı yerden devam et';
      bulkResume.disabled = busy || !!bulkRead;
      bulkNew.hidden = !bulkJob && !bulkState;
      bulkNew.disabled = busy || !!bulkRead || !!bulkState?.persistentPending || !!bulkJob?.pendingDownload;
      zipTekrar.disabled = !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!listeBekliyor;
      zipDurdur.hidden = !zipRun;
      zipDurdur.disabled = !!zipRun?.ac.signal.aborted || (zipRun?.managed && bulkState?.status === 'paused');
      teyitDurumu();
      bankaCiz();
    }
    function zipMessage(text, error = false) {
      zipStatus.textContent = text;
      zipStatus.classList.toggle('err', error);
    }
    const zipTitle = x => zipTools.documentName(rec, x, 'bin').replace(/\.bin$/i, '');
    function bulkWatch(states) {
      if (closed) return;
      bulkState = states.find(state => state.fileKey === rec.key) || null;
      if (!bulkState) { if (zipRun?.managed) zipRun = null; zipSync(); return; }
      const active = ['queued', 'running'].includes(bulkState.status) || bulkState.phase !== 'idle' && !bulkState.persistentPending;
      if (active) {
        if (!zipRun || zipRun.bulk) zipRun = { bulk: true, managed: true, ac: new AbortController(), packAc: new AbortController() };
        zipProgress.max = bulkState.total; zipProgress.value = bulkState.saved; zipProgress.hidden = false;
      } else if (zipRun?.managed) { zipRun = null; zipProgress.hidden = true; }
      const stage = { waiting: 'Kuyrukta', fetching: 'Evrak alınıyor', packing: 'ZIP hazırlanıyor', saving: 'Diske kaydediliyor' }[bulkState.phase];
      const result = bulkState.status === 'complete' ? 'İndirme tamamlandı.' : bulkState.status === 'error' ? bulkState.error :
        bulkState.status === 'paused' && !active ? 'Duraklatıldı. Kaldığı yerden devam edebilirsiniz.' : stage || 'İndirme sürüyor';
      zipMessage(`${result} ${fmtNum(bulkState.saved)}/${fmtNum(bulkState.total)} evrak kaydedildi · ${fmtNum(bulkState.inPart)} evrak bu parçada.`, bulkState.status === 'error');
      const signature = `${bulkState.id}|${bulkState.saved}|${bulkState.partCount}|${bulkState.status}`;
      if (!active && signature !== bulkFinished) { bulkFinished = signature; bulkLoad(true); }
      zipSync();
    }
    async function bulkLoad(force = false) {
      if (!bulkTools || !globalThis.UHDStorage?.getBulkDownload || closed) return null;
      if (bulkRead) return bulkRead;
      if (bulkLoaded && !force) return bulkJob;
      bulkRead = (async () => {
        try {
          const job = await globalThis.UHDStorage.getBulkDownload(rec.key);
          if (closed) return null;
          if (job && bulkTools.check(job).fileKey !== rec.key) throw new Error('İndirme planı bu dosyaya ait değil.');
          bulkJob = job;
          if (job && downloads)
            downloads.track({ rec, fileKey: rec.key, job, readDocument: createDownloadReader(rec, kaynak) });
          bulkIssue = '';
          bulkLoaded = true;
          return job;
        } catch (err) {
          if (!closed) { bulkIssue = `İndirme kaydı okunamadı: ${err.message}`; bulkLoaded = false; }
          return null;
        } finally { bulkRead = null; if (!closed) zipSync(); }
      })();
      zipSync();
