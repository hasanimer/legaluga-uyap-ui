      if (active) {
        if (!zipRun || zipRun.bulk) zipRun = { bulk: true, managed: true, ac: new AbortController(), packAc: new AbortController() };
        zipProgress.max = bulkState.total; zipProgress.value = bulkState.saved; zipProgress.hidden = false;
      } else if (zipRun?.managed) { zipRun = null; zipProgress.hidden = true; }
      const stage = { waiting: 'Kuyrukta', fetching: 'Evrak alınıyor', packing: 'ZIP hazırlanıyor', saving: 'Diske kaydediliyor' }[bulkState.phase];
      const result = bulkState.status === 'complete' ? 'İndirme tamamlandı.' : bulkState.status === 'error' ? bulkState.error :
        bulkState.status === 'paused' && !active ? 'Duraklatıldı. Kaldığı yerden devam edebilirsiniz.' : stage || 'İndirme sürüyor';
      zipMessage(`${result} ${fmtNum(bulkState.saved)}/${fmtNum(bulkState.total)} evrak kaydedildi · ${fmtNum(bulkState.inPart)} evrak bu parçada.`, bulkState.status === 'error');
      const signature = `${bulkState.id}|${bulkState.saved}|${bulkState.partCount}|${bulkState.status}`;
      if (!active && signature !== bulkFinished) { bulkFinished = signature; bulkLoad(true); }
      zipSync();
    }
    async function bulkLoad(force = false) {
      if (!bulkTools || !globalThis.UHDStorage?.getBulkDownload || closed) return null;
      if (bulkRead) return bulkRead;
      if (bulkLoaded && !force) return bulkJob;
      bulkRead = (async () => {
        try {
          const job = await globalThis.UHDStorage.getBulkDownload(rec.key);
          if (closed) return null;
          if (job && bulkTools.check(job).fileKey !== rec.key) throw new Error('İndirme planı bu dosyaya ait değil.');
          bulkJob = job;
          if (job && downloads)
            downloads.track({ rec, fileKey: rec.key, job, readDocument: createDownloadReader(rec, kaynak) });
          bulkIssue = '';
          bulkLoaded = true;
          return job;
        } catch (err) {
          if (!closed) { bulkIssue = `İndirme kaydı okunamadı: ${err.message}`; bulkLoaded = false; }
          return null;
        } finally { bulkRead = null; if (!closed) zipSync(); }
      })();
      zipSync();
      return bulkRead;
    }
    
