      zipIndir.title = zipParts.checked && (bulkJob || bulkState) ? 'Yeni bir indirme için Yeni indirme planı seçin; kalan evraklar için devam edin.' : listeBekliyor ? 'Evrak listesi UYAP’tan alınıyor.' : kaynak?.list.kilit ? 'UYAP evrak listesi kilitli.' : bankaOkuma ? 'Banka cevapları okunurken ZIP indirilemez.' : paketSession ? 'Duruşma paketi hazırlanırken ZIP indirilemez.' : '';
      paketAc.disabled = !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!listeBekliyor || !kaynak || !!kaynak.list.kilit || !tum.length;
      paketAc.title = bankaOkuma ? 'Banka cevapları okunurken paket hazırlanamaz.' : zipRun ? 'ZIP indirmesi sürerken paket hazırlanamaz.' : listeBekliyor ? 'Evrak listesi yükleniyor.' : kaynak?.list.kilit ? 'UYAP evrak listesi kilitli.'
        : paketMod ? 'Paket seçimini kapat (işaretler korunur)' : 'Listedeki evrakları işaretleyerek sıralı, içindekilerli PDF paketi hazırla';
      paketAc.setAttribute('aria-pressed', String(paketMod));
      paketAc.textContent = paketMod ? 'Paket seçimini kapat' : 'Duruşma paketi hazırla';
      paketAc.classList.toggle('on', paketMod);
      paketBar.hidden = !paketMod;
      paketYaz();
      zipEkler.disabled = !!zipRun;
      zipParts.disabled = !!zipRun || !bulkTools;
      bulkCard.hidden = !bulkJob && !bulkState && !bulkIssue;
      if (bulkJob || bulkState) {
        const last = bulkState ? bulkState.lastPart : bulkJob.parts.at(-1);
        bulkStatus.textContent = `${fmtNum(bulkState?.saved ?? bulkJob.cursor)}/${fmtNum(bulkState?.total ?? bulkJob.targets.length)} evrak diske kaydedildi · ${fmtNum(bulkState?.partCount ?? bulkJob.parts.length)} ZIP parçası${last ? ` · Son kayıt: ${new Date(last.completedAt).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' })}` : ''}. ` +
          (bulkState?.persistentPending || bulkJob?.pendingDownload ? 'Chrome indirmesi henüz tamamlanmadı. Durumunu kontrol edebilirsiniz.' : savedPlan ? 'Devam etmek kaydedilmiş kapsamı kullanır; yukarıdaki seçimler bu planı değiştirmez.' : 'Bu indirme tamamlandı.') + (bulkIssue ? ` ${bulkIssue}` : '');
      } else bulkStatus.textContent = bulkIssue;
      bulkResume.hidden = !savedPlan;
      bulkResume.textContent = bulkState?.persistentPending || bulkJob?.pendingDownload ? 'İndirme durumunu kontrol et' : 'Kaldığı yerden devam et';
      bulkResume.disabled = busy || !!bulkRead;
      bulkNew.hidden = !bulkJob && !bulkState;
      bulkNew.disabled = busy || !!bulkRead || !!bulkState?.persistentPending || !!bulkJob?.pendingDownload;
      zipTekrar.disabled = !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!listeBekliyor;
      zipDurdur.hidden = !zipRun;
