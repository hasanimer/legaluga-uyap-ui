          title: 'Ana evrakı görüntüle (Enter)', 'aria-label': `${x.tur} evrakını aç` }, 'Evrakı aç') : null;
        if (ac) ac.addEventListener('click', ev => { ev.stopPropagation(); sec(i, true); ogeler.focus({ preventScroll: true }); });
        const b = el('div', { class: 'ek-oge' + (x.ana ? ' ek-alt' : '') + (on ? ' on' : '') + (paketMod ? ' paketli' : ''), role: kategorili ? 'treeitem' : 'option', 'aria-level': kategorili ? (ustK ? '3' : '2') : null,
          'aria-expanded': kategorili && anaK ? String(acik) : null, 'aria-description': anaK ? ekDurum(acik, sayi) : null, 'data-ek-expanded': anaK ? String(acik) : null,
