      } else { evrakOdak = null; ogeler.removeAttribute('aria-activedescendant'); }
    }
    function listeyiCiz() {
      const ana = kaynakGrubu();
      const scrollTop = ogeler.scrollTop;
      const paketNo = new Map(paketMod ? paketSirasi().map((x, i) => [paketAnahtar(x), i + 1]) : []);
      const indisler = new Map(gorunen.map((x, i) => [x, i]));
      // Listelenen ana evrakların listelenen ek sayısı. Ana evrakı listede olmayan ek (yalnız eki bulan arama, yetim ek) hep görünür.
      const anaVar = new Set(gorunen.filter(x => !x.ana && x.ekSayisi).map(paketAnahtar)), ekSay = new Map();
      for (const x of gorunen) if (x.ana && anaVar.has(paketAnahtar(x.ana))) ekSay.set(paketAnahtar(x.ana), (ekSay.get(paketAnahtar(x.ana)) || 0) + 1);
