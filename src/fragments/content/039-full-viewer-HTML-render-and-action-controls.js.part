    const zipKapsamlar = el('div', { class: 'ti-kapsam', role: 'radiogroup', 'aria-label': 'İndirilecek evraklar' });
    let zipKapsam = 'tumu';   // 'tumu' | 'son20' | 'yeni' | 'gorunen' (Evrak sekmesinde grup ve aramayla listelenenler)
