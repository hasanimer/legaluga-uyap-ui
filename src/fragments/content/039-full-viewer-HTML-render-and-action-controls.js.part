        // başlıktaki küçük ok açık/kapalı durumu gösterir. Ana evrakın kendisi ayrı Evrakı aç eylemiyle görüntülenir.
        const anaK = !x.ana && ekSay.has(paketAnahtar(x)) ? paketAnahtar(x) : null, ustK = x.ana && ekSay.has(paketAnahtar(x.ana)) ? paketAnahtar(x.ana) : null;
        const acik = !!anaK && ekAcik(anaK), n = anaK ? ekSay.get(anaK) : 0;
