    zipTypeMode.value = 'all';
    const zipTypeSearch = el('input', { type: 'search', 'data-zip': 'tur-ara', placeholder: 'Evrak türünde ara', 'aria-label': 'Evrak türlerinde ara', autocomplete: 'off' });
