          const box = el('details', { class: 'ek-kategori' + (level === 1 ? ' ek-dosya-klasoru' : ''), role: 'none', 'data-kategori': kat.key }, head,
            el('div', { class: 'ek-kategori-icerik', role: 'group', id: `${kimlik}-cg${index}` }, content));
