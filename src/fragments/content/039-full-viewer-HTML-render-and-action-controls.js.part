          .map((x, i) => ({ x, i })).sort((a, b) => onayTs(b.x) - onayTs(a.x) || a.i - b.i).map(({ x }) => x);
        // Yeni evrakın ekleri de onun ardından gelir: sırayla okurken ekler de açılır, "görüldü say" en son ekten sonra çıkar.
        const alindi = new Set();
        yeni = yeni.flatMap(a => [a, ...tum.filter(x => x.ana && x.ana.k === a.k && (!a.dosya || !x.dosya || x.dosya === a.dosya))])
          .filter(x => { const a = x.k + '\n' + x.dosya; if (alindi.has(a)) return false; alindi.add(a); return true; });
        // Yeni evrakın ekleri açık gelir: son ek görünür, End ve son satıra tıklama ona ulaşır. Her ana evrakın ekleri ekranda bir kez
        // açılır; kullanıcının sonradan kapattığı ekler liste yenilense de kapalı kalır.
        for (const a of yeni.filter(x => x.ana).map(x => paketAnahtar(x.ana))) if (!yeniAcilanEk.has(a)) { yeniAcilanEk.add(a); acikEkler.add(a); }
      }
      // Liste her kurulduğunda (ilk liste, tam liste, yenileme, kimlik tazeleme) teyit yeniden hesaplanır; önceki "Tam liste
      // alınamadı" hatası da silinir (liste başka yoldan tamlanmış olabilir).
      teyitHata = '';
      teyit = evrakTeyit(kaynak.list, tum);
      teyitCiz();
    }
    const teyitMesgul = () => !!zipRun || !!bankRun || !!paketSession || !!bankaOkuma || !!tebligatRead || !!tebligatList || !!listeBekliyor;
    const teyitBos = () => (teyit ? evrakTeyitMetni(teyit).bos : '') || '';
    function teyitDurumu() {
      evrakYenile.disabled = teyitMesgul();
      evrakYenile.textContent = teyitAlim ? 'Yenileniyor…' : 'Yenile';
      if (!teyitDugme) return;
      teyitDugme.disabled = teyitMesgul();
      teyitDugme.textContent = teyitAlim ? 'Tam liste alınıyor…' : 'Tam listeyi al';
    }
    // Teyit satırı: metin, sınıfa göre işaret, ayrıntılar ve türlere göre küçük tablo. Kilitte gösterilmez.
    function teyitCiz() {
      const eski = teyitSatir.querySelector('.ek-teyit-turler');
      if (eski) teyitAcik = !!eski.open;
      // Yeniden çizim odaktaki düğmeyi ya da özeti DOM'dan çıkarır: odak satırdaysa çizimden sonra karşılığına (pasifse satıra) döner.
      const odak = shadowRoot.activeElement;
      const odakta = odak && teyitSatir.contains(odak) ? (odak === teyitDugme ? 'dugme' : odak === teyitOzet ? 'ozet' : 'satir') : null;
      teyitDugme = null; teyitOzet = null;
      const t = teyit;
      // Son Güncelle'nin bu dosya için bıraktığı uyarılar (yalnız kayıttaki kısa metinler).
      const sonGuncelle = Array.isArray(rec.evrakTeyit?.uyari) ? rec.evrakTeyit.uyari.filter(u => typeof u === 'string' && u).slice(0, 5) : [];
      // Normal eşleşmede bildirim yoktur; yalnız eksik, açılamayan veya kapsamı eksik evrak uyarılır.
      const goster = !!t && t.durum !== 'kilit' && !!kaynak && !kaynak.list.kilit && (t.durum === 'farkli' || t.ayniKimlik > 0 || t.acilamaz.sayi > 0 ||
        sonGuncelle.length > 0 || !!teyitHata || t.kapsam.nedenler.some(n => n !== 'sayfaSayisi'));
      if (!goster) { teyitSatir.hidden = true; teyitSatir.replaceChildren(); if (odakta) ogeler.focus({ preventScroll: true }); return; }
      const m = evrakTeyitMetni(t);
      const ayrinti = [...m.ayrinti, ...sonGuncelle.map(u => `Son Güncelle’de: ${u}`)];
      const sorun = m.metin.replace(/^(?:UYAP listesiyle|Okunan kısım UYAP listesiyle) eşleşti: [\d.,]+ evrak(?:, [\d.,]+ ek)?\.\s*/, '');
      teyitSatir.setAttribute('class', 'ek-teyit uyari');
      const parca = [el('p', { class: 'ek-teyit-metin' }, el('span', { class: 'ek-teyit-isaret', 'aria-hidden': 'true' }, '⚠'), ' ', sorun || 'Bazı evraklar için sorun var; ayrıntıları inceleyin.')];
      if (ayrinti.length) parca.push(el('ul', { class: 'ek-teyit-ayrinti' }, ...ayrinti.map(s => el('li', null, s))));
      if (t.kapsam.nedenler.includes('sayfa')) {
        teyitDugme = el('button', { type: 'button', class: 'chip ek-teyit-tam', title: 'UYAP’tan bütün sayfaları ister; büyük dosyada sürebilir.' }, 'Tam listeyi al');
        teyitDugme.addEventListener('click', () => { tamListeAl(); });
        teyitDurumu();
        parca.push(teyitDugme);
      }
      if (teyitHata) parca.push(el('p', { class: 'dp-err' }, teyitHata));
      const tablo = (baslik, grup) => grup.turler.length ? [el('p', { class: 'ek-teyit-baslik' }, baslik), el('table', { class: 'ek-teyit-tablo' },
        el('thead', null, el('tr', null, el('th', { scope: 'col' }, 'Tür'), el('th', { scope: 'col' }, 'UYAP'), el('th', { scope: 'col' }, 'Listede'))),
        el('tbody', null, ...grup.turler.map(x => el('tr', { class: x.uyap !== x.listede ? 'fark' : null },
          el('td', null, x.tur), el('td', null, fmtNum(x.uyap)), el('td', null, fmtNum(x.listede))))))] : [];
      const tablolar = [...tablo('Evraklar', t.evrak), ...tablo('Ekler', t.ek)];
      if (tablolar.length) {
        teyitOzet = el('summary', null, 'Türlere göre');
        const turler = el('details', { class: 'ek-teyit-turler' }, teyitOzet, ...tablolar);
