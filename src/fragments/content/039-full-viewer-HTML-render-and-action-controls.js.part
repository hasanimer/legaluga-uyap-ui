      ogeler.scrollTop = scrollTop;
      if (bekleyenAna && ekDom.has(bekleyenAna) && gorunen[sira]?.ana && paketAnahtar(gorunen[sira].ana) === bekleyenAna) { ekAc(bekleyenAna, true, true); bekleyenAna = null; }
      odakSync();
      listeDurum.textContent = !gorunen.length ? (ara.value.trim() ? 'Aramaya uyan evrak yok.'
        : kaynak && kaynak.list.kilit ? 'Evrak, savcı onayından sonra görünür.' : teyitBos() || 'Bu grupta evrak yok.') : '';
      listeDurum.hidden = !!gorunen.length;
      const sayim = evrakSayim(gorunen);
      listeSayi.textContent = sayim.ek ? `${fmtNum(sayim.evrak)} evrak · ${fmtNum(sayim.ek)} ek` : `${fmtNum(sayim.evrak)} evrak`;
      zipSync();
    }
    function secimiCiz(visible = false) {
      for (const node of ogeler.querySelectorAll('.ek-oge')) {
        const on = Number(node.dataset.i) === sira;
        node.classList.toggle('on', on);
        node.setAttribute('aria-selected', String(on));
      }
      if (sira >= 0) {
        const node = ogeler.querySelector(`[data-i="${sira}"]`);
        if (node?.dataset.kategori) kategoriYoluAc(node.dataset.kategori);
        // Kapalı eke gelinince (önceki/sonraki, ← →, Sırayla oku) ana evrakın ekleri açılır; arama temizlense de açık kalır.
        const x = gorunen[sira];
        const a = x?.ana ? paketAnahtar(x.ana) : null;
        if (a && ekDom.has(a)) ekAc(a, true, true);
        bekleyenAna = a && !ekDom.has(a) ? a : null;
