          : [tarihYaz(x.onay), x.dosya && x.dosya !== ana ? evrakDosyaAdi(x.dosya) : '', x.gonderen, x.ekSayisi ? `${fmtNum(x.ekSayisi)} ek` : '']).filter(Boolean).join(' · ');
        const isaret = anaK ? el('span', { class: 'ek-ekler-ok', 'aria-hidden': 'true' }, '▸') : null;
        const ad = el('b', null, isaret, (x.ana || x.yetimEk) && !/^Ek\s/.test(x.tur) ? el('span', { class: 'ek-rozet' }, 'Ek') : null, x.tur);
        const no = paketNo.get(paketAnahtar(x));
