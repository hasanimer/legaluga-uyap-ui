          : [tarihYaz(x.onay), x.dosya && x.dosya !== ana ? evrakDosyaAdi(x.dosya) : '', x.gonderen, x.ekSayisi ? `${fmtNum(x.ekSayisi)} ek` : '']).filter(Boolean).join(' · ');
        const isaret = anaK ? el('span', { class: 'ek-ekler-ok', 'aria-hidden': 'true' }, '▸') : null;
        const ad = el('b', null, isaret, (x.ana || x.yetimEk) && !/^Ek\s/.test(x.tur) ? el('span', { class: 'ek-rozet' }, 'Ek') : null, x.tur);
        const no = paketNo.get(paketAnahtar(x));
        const alinir = paketMod && paketAlinir(x);
        const kutu = paketMod ? el('input', { type: 'checkbox', class: 'ek-paket-kutu', tabindex: '-1', 'aria-hidden': 'true', checked: !!no, disabled: !alinir,
          title: alinir ? (no ? 'Paketten çıkar' : 'Pakete al') : 'UYAP bu eke kimlik vermediği için pakete alınamıyor' }) : null;
        if (kutu) kutu.addEventListener('click', ev => { ev.stopPropagation(); paketIsaretle(x, kutu.checked); });
        const sayi = anaK ? (n === x.ekSayisi ? `${fmtNum(n)} ek` : `${fmtNum(n)}/${fmtNum(x.ekSayisi)} ek`) : '';
        const b = el('div', { class: 'ek-oge' + (x.ana ? ' ek-alt' : '') + (on ? ' on' : '') + (paketMod ? ' paketli' : ''), role: kategorili ? 'treeitem' : 'option', 'aria-level': kategorili ? String(ustK ? level + 1 : level) : null,
          'aria-expanded': kategorili && anaK ? String(acik) : null, 'aria-description': anaK ? ekDurum(acik, sayi) : null, 'data-ek-expanded': anaK ? String(acik) : null,
          id: `${kimlik}-o${i}`, 'aria-selected': String(on),
          'aria-checked': paketMod ? String(!!no) : null, 'data-i': String(i), 'data-kategori': kategori },
          ...(paketMod ? [kutu, el('span', { class: 'ek-oge-metin' }, ad, el('small', null, alt)), no ? el('span', { class: 'ek-paket-no', title: 'Paketteki sırası' }, String(no)) : null]
            : [ad, el('small', null, alt)]));
