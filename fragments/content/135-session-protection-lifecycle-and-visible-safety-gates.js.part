          gate.lastSuccess = lastUyapRequest;
          gate.failures = 0; gate.blocked = false; gate.nextAt = 0;
          await chrome.storage.local.set({ [SESSION_GATE]: gate });
          if (!current()) return;
          log('UYAP oturumu açık tutuldu.');
          lossWarned = false; lossReason = ''; lossGap = null;
          clearTitleCountdown(); dropNotice(); shareLastRequest();
        } catch (e) {
          // İptal edilen ya da önceki oturuma ait yanıt yeni girişin durumunu değiştiremez.
          if (revision !== sessionRevision || !canProtect() || (controller.signal.aborted && !timedOut)) return;
          gate.failures = Math.min(6, gate.failures + 1);
          gate.nextAt = Math.max(Date.now() + Math.min(YOKLAMA_MS, 60000 * 2 ** (gate.failures - 1)), Number(e.retryAt) || 0);
          gate.blocked = e instanceof Blocked || [403, 429, 503].includes(e.status) || e.code === 'PRTL_GNL_100063';
          await chrome.storage.local.set({ [SESSION_GATE]: gate });
          if (revision !== sessionRevision || !canProtect()) return;
          if (sessionGone(e)) warnSessionGone(e, since);
          else {
            log('Oturum yoklaması başarısız:', e.message);
            if (manual || gate.blocked || sessionNotice?.tag === 'uyari') {
              const message = gate.blocked ? 'UYAP güvenlik veya yoğunluk nedeniyle isteği durdurdu. Otomatik yoklama duraklatıldı; UYAP ekranındaki uyarıyı kontrol edin.'
                : timedOut ? 'Oturum kontrolü zaman aşımına uğradı. Bağlantı düzeldiğinde yeniden deneyebilirsiniz.'
                  : `Oturum uzatılamadı: ${e.message}`;
              setNotice('uzatilamadi', message, 'err', { label: 'Tekrar dene', keep: true, fn: () => sessionPing(true) });
            }
          }
        }
      });
    } catch (e) {
      if (revision === sessionRevision && canProtect()) {
        log('Oturum yoklaması başarısız:', e.message);
        if (manual) setNotice('uzatilamadi', `Oturum koruması çalıştırılamadı: ${e.message}`, 'err');
      }
    } finally {
      clearTimeout(timeout);
      if (sessionPingController === controller) sessionPingController = null;
      keepAliveBusy = false;
    }
  }

  // 30 dakikadan uzun boşluktan sonraki ilk işlemde de yoklanır: kapanmış oturumu bir istek yeniden açamaz (UYAP 100026
  // döner), ama kullanıcı yazmayı sürdürmeden uyarılır. Eklentinin görmediği bir istek oturumu açık tuttuysa koruma sürer.
  function onActivity(e) {
    if (!e.isTrusted || document.hidden || sessionDisposed || navigator.onLine === false) return;
    // Kapalı ShadowRoot'taki bildirim düğmeleri burada ana host olarak görünür. pointerdown, açık manuel
    // tıklamadan önce otomatik yoklama başlatıp onun önüne geçmemeli.
    if (e.target?.id === 'uhd-host') return;
    lastSessionActivity = Date.now();
    if (contextGone) { if (sessionNotice?.tag !== 'yenile') sessionInvalidated(); return; }
    if (keepAliveBusy || Date.now() - lastUyapRequest < YOKLAMA_MS) return;
    if (lossWarned && recoveryRequestAt <= lastPingTry) return;
    if (canProtect()) sessionPing();
  }
  const ACTIVITY = ['keydown', 'pointerdown', 'wheel', 'input', 'compositionend'];
  for (const type of ACTIVITY) window.addEventListener(type, onActivity, { capture: true, passive: true });
  // UYAP'ın belge düzenleyicisi tuşları aynı kaynaklı gizli bir çerçeveye alır; oradaki olaylar üst pencereye ulaşmaz.
  const hookedDocs = new WeakSet();
  function hookFrames() {
    for (const f of document.getElementsByTagName('iframe')) {
      let d = null;
      try { d = f.contentDocument; } catch (_) {}
      if (!d || hookedDocs.has(d)) continue;
      hookedDocs.add(d);
      for (const type of ACTIVITY) d.addEventListener(type, onActivity, { capture: true, passive: true });
    }
  }
  document.addEventListener('focusin', hookFrames, true);
  window.addEventListener('blur', () => setTimeout(hookFrames, 0));

  // ---- kapanış
  function sessionEnded(now) {
    if (requestObserver) pageRequests(requestObserver.takeRecords());   // kapanışı getiren istek henüz işlenmemiş olabilir
    clearTitleCountdown();
    const minutes = sessionSince ? ` Oturum bu sayfada ${Math.round((now - sessionSince) / 60000)} dk açık kaldı.` : '';
    if (loggingOut || lostElsewhere) { dropNotice(); return log('UYAP oturumu kapandı (çıkış ya da başka bir sekme).' + minutes); }
    // Oturumu kapatan, UYAP'ın o anki isteğidir: ondan önceki istekle arası 30 dakikayı bulduysa kural gereği kapanmıştır.
    let gap = Math.max(0, ...requestGaps.filter(([at]) => now - at <= 120000).map(([, g]) => g));
    let known = true;
    if (lossWarned && lossGap !== null) gap = lossGap;   // kaybı yoklama gördü: ölçü o anki boşluktur
    else if (now - loadedAt <= 120000) {   // sayfa yeni yüklendi: boşluk yüklemeden önceki son isteğe göre ölçülür
      if (priorRequest === null) known = false;
      else gap = Math.max(gap, loadedAt - priorRequest);
    }
    const min = Math.round(gap / 60000);
    log(`UYAP oturumu kapandı; istekler arasındaki en uzun boşluk ${known ? min + ' dk' : 'bilinmiyor'}.${minutes}`);
    if (!keepAliveOn()) return dropNotice();
    if (lossReason === 'baska-oturum') {
      setNotice('bitti', `UYAP, aynı hesapla başka bir yerde giriş yapıldığı için oturumu kapattı; yeniden giriş yapabilirsiniz.`);
    } else if (!known) {
      setNotice('bitti', 'UYAP oturumu kapanmış. UYAP, 30 dakika işlem yapılmazsa ya da aynı hesapla başka bir yerde giriş yapılırsa oturumu kapatır; yeniden giriş yapabilirsiniz.');
    } else if (gap >= OTURUM_MS - 60000) {
      setNotice('bitti', 'UYAP oturumu 30 dakika işlem yapılmadığı için kapandı. UYAP bir hata iletisi gösterdiyse nedeni budur; yeniden giriş yapabilirsiniz.');
    } else {
      setNotice('bitti', `UYAP oturumu beklenenden önce kapandı${min >= 2 ? ` (son istekten yaklaşık ${min} dakika sonra)` : ''}. ${TEK_OTURUM} Bağlantı kopması da neden olabilir.`, 'err');
    }
  }

  function sessionTick() {
    hookFrames();
    const now = Date.now();
    if (/^\/cikis(\/|$)/.test(location.pathname)) loggingOut = true;   // UYAP'ın Çıkış ekranı (kill_session yanıtından önce)
    const active = inSession();
    if (sessionSeen && !active) { abortSessionPing(); sessionEnded(now); }
    if (active && !sessionSeen) {   // yeni oturum (ya da aynı sekmede yeniden giriş)
      sessionRevision++;
      abortSessionPing();
      sessionResetAt = now;
      lastSessionActivity = 0;
      loggingOut = false; lostElsewhere = false; lossWarned = false; lossReason = ''; lossGap = null; sessionSince = now;
      lastUyapRequest = now;
      dropNotice();
    }
    if (!active && sessionSeen) sessionRevision++;
    sessionSeen = active;
    if (active && !loggingOut) shareLastRequest();
    if (!active) return renderNotice();
    if (!keepAliveOn()) { abortSessionPing(); clearTitleCountdown(); return dropNotice(); }
    sessionContextAvailable();
    if (contextGone) {
      abortSessionPing(); clearTitleCountdown();
      if (sessionNotice?.tag !== 'yenile') sessionInvalidated();
      return renderNotice();
    }
    if (loggingOut || sessionDisposed) { abortSessionPing(); return; }
    if (lossWarned) {
      clearTitleCountdown();
      // Yalnız sonraki UYAP işlemi varsa yeniden doğrula; istek zamanını başarı kanıtı sayma.
      // sessionPing'in dakika sınırı, kapalı oturumda her tıklamada istek gönderilmesini önler.
      if (recoveryRequestAt > lastPingTry && recentlyActive()) sessionPing();
      return renderNotice();
    }
    const left = lastUyapRequest + OTURUM_MS - now;
    if (left > 0 && left <= UYARI_MS) {
      const min = Math.max(1, Math.ceil(left / 60000));
      setTitleCountdown(min);
      const text = `UYAP oturumu yaklaşık ${min} dakika içinde kapanacak; ekrandaki kaydedilmemiş bilgiler kaybolur.`;
      if (sessionNotice?.tag !== 'uzatilamadi' && (sessionNotice?.tag !== 'uyari' || sessionNotice.text !== text)) {
        setNotice('uyari', text, '',
          { label: 'Oturumu uzat', keep: true, fn: () => sessionPing(true) });
      }
    } else if (left <= -60000) {
      // Eklentinin ölçüsüyle oturum kapandı ama UYAP'ın ekranı bunu ancak bir sonraki işlemde anlar: önceden söylenir.
      // Bir dakikalık pay, öteki sekmeden gelen paylaşımın gecikmesine karşıdır.
      clearTitleCountdown();
      if (!sessionNotice || sessionNotice.tag !== 'bosta') setNotice('bosta', `UYAP oturumu 30 dakika işlem yapılmadığı için büyük olasılıkla kapandı. ${KAYIP_METNI}`, 'err');
    } else {
      clearTitleCountdown();
      if (sessionNotice && ['uyari', 'bosta'].includes(sessionNotice.tag)) dropNotice();
    }
    // Uzun yazımda tek bir keydown eski isteğe denk gelmeyebilir. Yalnız yakın zamanda gerçek etkinlik varsa yokla;
    // boşta duran veya uyku/arka plan dönüşü yapan sekme zamanlayıcısı oturumu kendiliğinden uzatmaz.
    if (recentlyActive() && Date.now() - lastUyapRequest >= YOKLAMA_MS) sessionPing();
    renderNotice();
  }
  const safeTick = () => { try { sessionTick(); } catch (e) { globalThis.UHDReporter?.report(e, 'session'); console.error('Legaluga oturum denetimi hatası:', e); } };
  sessionSeen = inSession();
  if (sessionSeen) sessionSince = loadedAt;
  if (typeof sessionRequestHooks !== 'undefined') sessionRequestHooks = {
    invalidate: sessionInvalidated, preferencesChanged: sessionPreferencesChanged,
    captureError() {
      const revision = sessionRevision, since = lastUyapRequest;
      return error => {
        if (revision === sessionRevision && canProtect() && sessionGone(error)) warnSessionGone(error, since);
      };
    }
  };
  try {
    const revision = sessionRevision;
    chrome.storage.local.get(SESSION_GATE).then(values => {
      if (revision === sessionRevision && sessionGate(values[SESSION_GATE]).blocked && !lastPingTry) showSessionPaused();
    }).catch(() => {});
    chrome.storage.onChanged.addListener((changes, area) => {
      if (area !== 'local' || !changes[SESSION_GATE]) return;
      const gate = sessionGate(changes[SESSION_GATE].newValue);
      if (gate.blocked) showSessionPaused();
      else if (gate.lastSuccess > 0 && gate.lastSuccess >= gate.lastAttempt && !lossWarned) dropNotice('uzatilamadi');
    });
  } catch (_) {}
  setInterval(safeTick, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) safeTick(); });
  window.addEventListener('offline', () => {
    abortSessionPing();
    if (keepAliveOn() && inSession() && recentlyActive()) setNotice('baglanti', 'İnternet bağlantısı kesildi; UYAP oturumu şu anda korunamıyor. Kaydedilmemiş bilgileri bir yere kopyalayın.', 'err');
    lastSessionActivity = 0;
  });
  window.addEventListener('online', () => { lastSessionActivity = 0; dropNotice('baglanti'); safeTick(); });
  window.addEventListener('pagehide', () => { sessionDisposed = true; sessionRevision++; abortSessionPing(); });
  window.addEventListener('pageshow', () => { sessionDisposed = false; lastSessionActivity = 0; safeTick(); });
})();
