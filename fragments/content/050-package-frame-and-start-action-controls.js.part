      paketSession = session;
      session.bridge = globalThis.UHD.durusmaPaketiBridge.create(frame, paketMesaj);
      paketDurum.textContent = `${fmtNum(sirali.length)} evrak için paket hazırlanıyor…`;
      zipSync();
      // Uzantı çerçevesi bağlanamazsa (eklenti yenilendi, güvenlik kanalı kurulamadı) beklemede kalınmaz.
      setTimeout(() => {
        if (paketSession !== session || session.basladi) return;
        paketKapat();
        paketDurum.textContent = 'Paket hazırlayıcı açılamadı. Sayfayı yenileyip tekrar deneyin.';
      }, 20000);
    }